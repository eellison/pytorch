+    def test_a_conv_learn_frees_its_probe_outputs_before_its_captures(self):
+        # a convolution's harvest reads only its fresh outputs' layouts: the
+        # learn drops _learn's probe outputs before it captures
+        seen = []
+        harvest_ = HarvestProvider._harvest
+
+        def spy(provider, key, args, kwargs, operands, *rest, **kw):
+            seen.append([o.device.type for o in operands])
+            return harvest_(provider, key, args, kwargs, operands, *rest, **kw)
+
+        def fn(x, w):
+            return torch.nn.functional.conv2d(x, w)
+
+        x, w = torch.randn(8, 16, 32, 32, device="cuda"), torch.randn(32, 16, 3, 3, device="cuda")
+        r = HostTraceReplay(fn, opaque=(HarvestProvider(("conv",)),))
+        with mock.patch.object(HarvestProvider, "_harvest", spy):
+            for _ in range(3):
+                self.assertEqual(r(x, w), fn(x, w))
+        self.assertGreater(r.replays, 0)
+        self.assertTrue(seen)
+        self.assertEqual({tuple(s) for s in seen}, {("cuda", "cuda", "meta")})
