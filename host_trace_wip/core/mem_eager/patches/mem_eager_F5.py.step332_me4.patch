+def _canonical(binding: OpaqueBinding, stale: Callable[[int], bool], like: OpaqueBinding | None = None) -> OpaqueBinding:
+    # each constant qword (alike in every capture, no slot's, not loose) whose
+    # high half is a stale address's with that half zeroed: cuDNN builds its
+    # parameter structs on the heap before the captures, and a field may hold
+    # another field's leftovers, an address's high half that depends on where
+    # things were mapped then (CUTLASS strided dgrad reads the high half of an
+    # int32's qword as a flag, and hangs on some). Zeroed, the binding no
+    # longer depends on the address space; verify judges that form, and the
+    # zeroed bytes are loose (a restore's capture holds its own leftovers).
+    # With `like` (a sibling's template): the template's zeroed high halves
+    def zeroed(n: OpaqueKernel) -> set[tuple[int, int]]:
+        return {(p, o - 4) for p, o, size in n.loose if size == 4 and o % 8 == 4 and not any(n.images[p][o : o + 4])}
+
+    nodes, changed = [], False
+    for x, n in enumerate(binding.nodes):
+        if not isinstance(n, OpaqueKernel):
+            nodes.append(n)
+            continue
+        template = like.nodes[x] if like is not None else None
+        near = {(s.param, s.offset + d) for s in n.slots for d in range(-7, 8)}
+        loose = {(p, o + i) for p, o, size in n.loose for i in range(size)}
+        images, runs = list(n.images), []
+        for param, image in enumerate(n.images):
+            for i, q in enumerate(_qwords(image, 0)):
+                off = 8 * i
+                if not q >> 32:
+                    continue
+                if template is not None:
+                    if (param, off) not in zeroed(template):
+                        continue
+                elif (param, off) in near or any((param, off + b) in loose for b in range(8)) or not stale(q):
+                    continue
+                images[param] = images[param][: off + 4] + bytes(4) + images[param][off + 8 :]
+                runs.append((param, off + 4, 4))
+        if runs:
+            changed = True
+            loose_runs = n.loose if template is not None else tuple(sorted({*n.loose, *runs}))
+            n = dataclasses.replace(n, images=tuple(images), loose=loose_runs)
+        nodes.append(n)
+    return dataclasses.replace(binding, nodes=tuple(nodes)) if changed else binding
+
