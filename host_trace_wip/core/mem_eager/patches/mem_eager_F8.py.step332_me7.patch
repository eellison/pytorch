+    def test_the_trace_call_frees_its_inputs_at_last_use(self):
+        # the call that traces warms up on the boxed list's references too
+        # (TraceHandback), the trace reading the dropped inputs' stand-ins: a
+        # backward's saved activations go as it consumes them, so its peak is
+        # the default compile's steady one but for its learns (a workspace,
+        # the 64 MiB of test_a_learn_costs_at_most_its_workspace)
+        def backward_peaks(mode):
+            torch._dynamo.reset()
+            torch.manual_seed(0)
+            model = torch.nn.Sequential(*(torch.nn.Sequential(torch.nn.Linear(4096, 4096, bias=False), torch.nn.ReLU()) for _ in range(4))).cuda()
+            compiled = torch.compile(model, mode=mode)
+            x = torch.randn(4096, 4096, device="cuda")
+            peaks = []
+            for _ in range(3):
+                model.zero_grad(set_to_none=True)
+                loss = compiled(x).sum()
+                torch.cuda.synchronize()
+                base = torch.cuda.memory_allocated()
+                torch.cuda.reset_peak_memory_stats()
+                loss.backward()
+                del loss
+                torch.cuda.synchronize()
+                peaks.append(torch.cuda.max_memory_allocated() - base)
+            return peaks
+
+        steady = backward_peaks(None)[2]
+        self.assertLessEqual(backward_peaks("reduce-overhead")[1], steady + (64 << 20))
+        self.assertEqual([(i.replay.traces, i.replay.replays) for i in self.installed], [(1, 1), (1, 1)])
+
