+def _hosts(
+    allocations: Sequence[Any], temporaries: Sequence[tuple[int, int, int]], hosts: Sequence[tuple[int, int]]
+) -> dict[int, tuple[int, int, int]]:
+    """Run temporaries (allocation, seq, last use) placed at offset 0 of a
+    tensor the run makes, `hosts` (first use's seq, allocation) in first-use
+    order: each host takes, one after another, temporaries of its bytes' row
+    (equal bytes at every call) whose last use precedes its first use, each
+    allocated at or after the last one's last use, as eager's caching
+    allocator gives a tensor the block of a freed temporary of its size. A
+    temporary is hosted once."""
+    out: dict[int, tuple[int, int, int]] = {}
+    for first, host in hosts:
+        end = -math.inf  # the last hosted temporary's last use
+        for k, seq, last in temporaries:
+            if k not in out and last < first and seq >= end and allocations[k].nbytes == allocations[host].nbytes:
+                out[k] = (host, seq, last)
+                end = last
+    return out
 
 
