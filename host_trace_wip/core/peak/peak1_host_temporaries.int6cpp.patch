+
+# pointwise chains: eager frees an intermediate after its last use, and the
+# next tensor of its size takes its block
+_CHAINS = {
+    "sigmoid_mul_add": lambda x, y: torch.sigmoid(x) * y + 2,
+    "four_ops": lambda x, y: (((x * 2).sin() + y) * 3).relu(),
+    "two_outputs": lambda x, y: ((x * 2).sin(), x + y),
+    # its output and partial sum are smaller than the chain's temporaries
+    "reduction": lambda x, y: (x * y).exp().sum(1) + 1,
+}
+
+
+@unittest.skipIf(not TEST_CUDA, "requires CUDA")
+class TestPeakMatchesEager(TestCase):
+    def peak(self, h, *args):
+        gc.collect()
+        torch.cuda.synchronize()
+        before = torch.cuda.memory_allocated()
+        torch.cuda.reset_peak_memory_stats()
+        out = h(*args)
+        torch.cuda.synchronize()
+        return out, torch.cuda.max_memory_allocated() - before
+
+    @parametrize("memory", ["auto", "eager", "run_buffer", "planned", "packed"])
+    @parametrize("chain", list(_CHAINS))
+    def test_a_chains_peak_is_eagers(self, chain, memory):
+        # a run's temporary that dies before a tensor the run makes is first
+        # touched lives in that tensor's bytes (host_temporaries), as eager's
+        # tensor takes the freed block: the replay's peak is eager's
+        fn = _CHAINS[chain]
+        f = HostTraceReplay(fn, memory=memory)
+        y = torch.randn(768, device="cuda")
+        for m in (7, 33):
+            f(torch.randn(m, 768, device="cuda"), y)
+        for m in (7, 33, 7):
+            x = torch.randn(m, 768, device="cuda")
+            (got, peak), (want, eager_peak) = self.peak(f, x, y), self.peak(fn, x, y)
+            self.assertEqual(got, want, atol=0, rtol=0)
+            if chain == "reduction" and memory != "eager":
+                # a tensor smaller than the temporaries is made with the run, before eager's frees: here
+                # the m-element output and, in a packed arena, the partial sum (a 512-byte block each)
+                self.assertLessEqual(peak, eager_peak + 2 * 512, (chain, memory, m))
+            else:
+                self.assertEqual(peak, eager_peak, (chain, memory, m))
+        self.assertEqual((f.traces, f.replays), (1, 3))
+
+    def test_without_hosting_the_run_buffer_holds_the_intermediate(self):
+        # host_temporaries off: the output is made with the run buffer, so
+        # the first intermediate's bytes are not reused (one tensor above eager)
+        fn = _CHAINS["sigmoid_mul_add"]
+        x, y = torch.randn(7, 768, device="cuda"), torch.randn(768, device="cuda")
+        with mock.patch("torch.cuda._host_trace.host_temporaries", False):
+            f = HostTraceReplay(fn, memory="run_buffer")
+            f(x, y), f(x, y)  # the first call runs eagerly, the second traces
+        (got, peak), (want, eager_peak) = self.peak(f, x, y), self.peak(fn, x, y)
+        self.assertEqual(got, want, atol=0, rtol=0)
+        self.assertEqual(peak, eager_peak + want.nbytes)
+        (v,) = f.variants
+        self.assertEqual(dict(v.memory.hosted), {})
+
+
+instantiate_parametrized_tests(TestPeakMatchesEager)
+
