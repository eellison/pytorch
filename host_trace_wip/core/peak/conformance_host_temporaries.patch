+    @parametrize("on", [False, True])
+    def test_case_host_temporaries(self, on):
+        # a run's temporary that dies before a tensor of its bytes the run makes is first touched lives in that
+        # tensor (MemoryPlan.hosted): sigmoid(x) * y + 2's first intermediate is in the output, so the run buffer's
+        # peak is eager's; off, the old placement, one tensor above
+        self.need("memory.host_temporaries")
+
+        def chain(x, y):
+            return torch.sigmoid(x) * y + 2
+
+        x, y = torch.randn(7, 768, device="cuda"), torch.randn(768, device="cuda")
+        with mock.patch.object(torch.cuda._host_trace, "host_temporaries", on):
+            r = _ht(chain, memory="run_buffer")
+            self.assertEqual(r(x, y), chain(x, y), atol=0, rtol=0)
+
+        def peak(h):
+            gc.collect()
+            torch.cuda.synchronize()
+            before = torch.cuda.memory_allocated()
+            torch.cuda.reset_peak_memory_stats()
+            out = h(x, y)
+            torch.cuda.synchronize()
+            return torch.cuda.max_memory_allocated() - before, out
+
+        (got_peak, got), (want_peak, want) = peak(r), peak(chain)
+        self.assertEqual(got, want, atol=0, rtol=0)
+        self.assertEqual(got_peak, want_peak if on else want_peak + want.nbytes)
+        self.assertEqual(bool(r.variants[0].memory.hosted), on)
+        self.took(r, replays=1)
