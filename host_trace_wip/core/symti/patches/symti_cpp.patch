-// memory::can_vectorize_up_to of an operand, at most up_to
-int vectorize_up_to(const c10::SymInt& address, int64_t element_size, int up_to) {
-  for (int vec = up_to; vec > 1; vec /= 2) {
-    if (address % (element_size * vec) == 0) {
-      return vec;
-    }
-  }
-  return 1;
-}
