+    at::native::gpu_kernel_body<SymHost, /*nocast=*/true>(iter, facts, SymFunctor{}, check_cast);
+  } else {
+    at::native::gpu_kernel_body<SymHost, /*nocast=*/false>(iter, facts, SymFunctor{}, check_cast);
