+    def sweep(self, fn, ms=(8, 40, 8, 40, 100), memory="auto"):
+        f = HostTraceReplay(fn, opaque=self.blas, memory=memory)
+        for m in ms:
+            x = torch.randn(m, 64, device="cuda")
+            self.assertEqual(f(x, self.w), fn(x, self.w), atol=0, rtol=0)
