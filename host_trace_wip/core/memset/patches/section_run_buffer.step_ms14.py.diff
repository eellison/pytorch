+def section_seqs(lowered: LoweredTape, plan: MemoryPlan, step: int, first: float, last: float) -> tuple[int, int]:
+    """Where HostTraceVariant::run_buffer places the temporaries of a section over launch seqs [first, last] of
+    run `step`: (the seq they are made at, just before the op's first launch; the seq of their last use, its
+    last launch), first fit with the run's own temporaries, so the next op's take their bytes as eager's do. In
+    a run with an order or no temporaries, or over a side stream's unbounded span: (-1, -1), made before the
+    run and held over it."""
+    m = plan.steps[step]
