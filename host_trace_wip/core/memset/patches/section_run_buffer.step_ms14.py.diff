+    def test_run_buffer_sections_stay_within_eager_order(self):
+        # a section's temporaries in a run buffer's run take the buffer's bytes over its op's launches, as eager makes
+        # and frees them around its op: sixteen sum ops, each a section at many rows (the split reduction's staging
+        # buffer and semaphores), peak as in eager order, not with sixteen staging buffers live at once
+        def fn(x):
+            out = x.sum(0)
+            for i in range(1, 16):
+                out = out + x.sum(0) * (i + 1)
+            return out
+
+        def peak(call):
+            torch.cuda.synchronize()
+            base = torch.cuda.memory_allocated()
+            torch.cuda.reset_peak_memory_stats()
+            out = call()
+            torch.cuda.synchronize()
+            return torch.cuda.max_memory_allocated() - base, out
+
+        peaks = {}
+        for memory in ("run_buffer", "eager"):
+            f = HostTraceReplay(fn, memory=memory)
+            for t in (100, 300, 5000, 6000):
+                x = torch.randn(t, 512, device="cuda")
+                self.assertEqual(f(x), fn(x), atol=0, rtol=0)
+            x = torch.randn(20000, 512, device="cuda")
+            self.assertEqual(f(x), fn(x), atol=0, rtol=0)
+            peaks[memory], out = peak(lambda: f(x))
+            self.assertEqual(out, fn(x), atol=0, rtol=0)
+            self.assertEqual((f.traces, f.redispatches), (1, 1))
+            self.assertGreater(f.sections, 0)
+        self.assertLessEqual(peaks["run_buffer"], peaks["eager"] + 2**20, peaks)
