+    def test_alternating_sizes_reuse_their_descriptor_encodes(self):
+        # A's descriptor extents follow m: the first call at each m encodes it,
+        # a later call at an m seen before takes that encode's map (the address
+        # replaced), with no encode. Outputs bitwise
+        bw = _example("cute/blackwell/kernel/dense_gemm/dense_gemm.py", "bw_dense_gemm")
+        a, b, c = (_half(1, 256, 64).permute(1, 2, 0) for _ in range(3))
+        op = bw.DenseGemmKernel(cutlass.Float32, False, (128, 128), (1, 1), True)
+        compile_args = [
+            from_dlpack(t, assumed_align=16).mark_layout_dynamic(leading_dim=1)
+            for t in (a, b, c)
+        ]
+        stream = make_fake_stream(use_tvm_ffi_env_stream=True)
+        gemm = cute.compile(op, *compile_args, stream, options="--enable-tvm-ffi")
+
+        def f(a, b):
+            c = a.new_empty(1, a.shape[0], b.shape[0]).permute(1, 2, 0)
+            gemm(a, b, c)
+            return c
+
+        r = HostTraceReplay(f)
+        b = _half(1, 128, 64).permute(1, 2, 0)
+        xs = {m: _half(1, m, 64).permute(1, 2, 0) for m in (256, 384)}
+        for m in (256, 384, 256, 384):
+            r(xs[m], b)
+        encodes, hits = torch._C._host_trace_tma_counts()[0], torch._C._host_trace_tma_cache_hits()
+        for m in (256, 384) * 3:
+            out = r(xs[m], b)
+            ref = xs[m].new_empty(1, m, 128).permute(1, 2, 0)
+            gemm(xs[m], b, ref)
+            self.assertEqual(out, ref, atol=0, rtol=0)
+        self.assertEqual(torch._C._host_trace_tma_counts()[0] - encodes, 0)
+        self.assertGreater(torch._C._host_trace_tma_cache_hits() - hits, 0)
+        self.assertEqual((r.traces, len(r.variants), r.eager), (1, 1, 0))
+
