     @parametrize("stable", [True, False])
+    def test_a_piece_whose_reads_repeat_is_not_packed(self, stable):
+        # n % 256 == 0 binds the scratch topology, a piece of the plain call's
+        # form: a repeated call at it with the same operands packs none of its
+        # nodes; a fresh y (an operand the piece reads) packs and patches it.
+        # Outputs bitwise
+        p = TableProvider(style="mixed")
+        f = HostTraceReplay(mul_chain, opaque=(p,))
+        base = torch.randn(4096, device="cuda")
+        x6, x5 = torch.randn(640, device="cuda"), torch.randn(512, device="cuda")
+        for _ in range(2):
+            f(x6, base[:640])
+            f(x5, base[:512])
+        self.assertEqual(len(bound(f)), 1)
+        skips = []
+        ys = [base[:512]] + [torch.randn(512, device="cuda") for _ in range(4)]
+        for i in range(4):
+            y = base[:512] if stable else ys[i + 1]
+            s0 = torch._C._host_trace_piece_skips()
+            self.assertEqual(f(x5, y), mul_chain(x5, y), atol=0, rtol=0)
+            skips.append(torch._C._host_trace_piece_skips() - s0)
+        # (the first call after the fresh tensors' allocations may move an intermediate)
+        self.assertEqual(skips[1:], [1] * 3 if stable else [0] * 3, skips)
+
