+def _lifetimes(lowered: LoweredTape, plan: MemoryPlan, step: int, first: float, own: Collection[int], drops: Collection[int]) -> dict[tuple[str, int], tuple[float, float]]:
+    """The bases of the run of `step` that may share bytes there, each (made, freed) in seqs, as
+    HostTraceVariant::allocate makes them before the run's graph is queued. In "eager" order (a run with
+    an order): its temporaries (made at their seq, freed after their last use), its tensors (never freed
+    in the run), its freed arguments, and a section's own temporaries (made before the op's first launch,
+    freed after its last). A run buffer's run (temporaries, no order): its temporaries, placed first fit
+    over their lifetimes; a section's are held over the run. A run of tensors only: its tensors, and a
+    section's own temporaries, made and freed before the first tensor the op's chain makes. A base absent
+    holds its bytes over the run (made before it, held or relocated, an eager output, a dropped one)."""
+    m = plan.steps[step]
+    seqs = _first_seqs(lowered)
+    skip = {k for k, *_ in plan.planned} | set(plan.relocated) | set(drops)
+    lives: dict[tuple[str, int], tuple[float, float]] = {("allocation", k): (seqs[k], last) for k, _, last in m.temporaries if k not in skip}
+    if m.order or not m.temporaries:
+        lives.update((("allocation", k), (seqs[k], math.inf)) for k in m.tensors if k not in skip)
+        section = (first - 0.5, math.inf) if m.order else (first - 0.5, first - 0.5)
+        lives.update((("section", b), section) for b in own)
+    lives.update((("argument", a), (-math.inf, seq)) for a, seq in (m.freed if m.order else ()))
+    return lives
