+    @parametrize("same", [True, False])
+    def test_a_row_switch_to_the_held_launch_sets_nothing(self, same):
+        # two keys (tags 1 and 2) of one site alternate on the same operands: with
+        # same, both rows launch the node exactly as it holds, so a switch only
+        # moves the record's row; else tag 2's grid has an idle block, so each
+        # switch sets the node
+        class Tagged(TableProvider):
+            def learn(self, key, args, kwargs, operands):
+                self.table[key] = self._binding(*operands)
+                if not same and key.scalars[0] == 2:
+                    (k,) = self.table[key].nodes
+                    grid = (k.grid[0] + 1, *k.grid[1:])
+                    self.table[key] = dataclasses.replace(self.table[key], nodes=(dataclasses.replace(k, grid=grid),))
+                return self.table[key]
+
+        p = Tagged(ops=(torch.ops.host_trace_test.mul_into_tagged.default,))
+
+        def fn(x, y, out, t):
+            mul_into_tagged(x, y, out, t.shape[0])
+            return add(out)
+
