+    @parametrize("stable", [True, False])
+    def test_forms_alternating_set_only_what_moved(self, stable):
+        # two sites, each binding either topology (TableProvider "mixed": n % 256), so up
+        # to four forms, cycled repeatedly. Each form's exec keeps what it held: with the
+        # same tensors per form, a revisit sets no node; with fresh tensors each call
+        # only the nodes reading them. Outputs bitwise either way
+        def fn(x, y, x2, y2):
+            return mul_chain(x, y), mul_chain(x2, y2)
+
+        p = TableProvider(style="mixed")
+        f = HostTraceReplay(fn, opaque=(p,))
+        base = torch.randn(4096, device="cuda")
+        sizes = [(512, 512), (640, 512), (512, 640), (640, 640)]
+
+        def args(n, m):
+            return (torch.randn(n, device="cuda"), base[:n], torch.randn(m, device="cuda"), base[:m])
+
+        fixed = {nm: args(*nm) for nm in sizes}
+        for _ in range(2):
+            for nm in sizes:
+                f(*fixed[nm])
+        self.assertEqual((len(f.variants), len(bound(f))), (1, 1))
+        visits = []
+        for i in range(16):
+            nm = sizes[i % 4]
+            a = fixed[nm] if stable else args(*nm)
+            sets = torch._C._host_trace_kernel_node_sets() + torch._C._host_trace_memory_node_sets()
+            self.assertEqual(f(*a), fn(*a), atol=0, rtol=0)
+            visits.append(torch._C._host_trace_kernel_node_sets() + torch._C._host_trace_memory_node_sets() - sets)
+        if stable:
+            self.assertEqual(visits, [0] * 16)
+        else:
+            # x and x2 are fresh: the adds reading them and the muls are set, not every node
+            self.assertTrue(all(0 < v for v in visits))
+        # without held state each call lands on another form's exec and sets its nodes
+        torch._C._host_trace_form_held(False)
+        try:
+            for nm in sizes:
+                sets = torch._C._host_trace_kernel_node_sets()
+                self.assertEqual(f(*fixed[nm]), fn(*fixed[nm]), atol=0, rtol=0)
+                self.assertGreater(torch._C._host_trace_kernel_node_sets() - sets, 0)
+        finally:
+            torch._C._host_trace_form_held(True)
+
