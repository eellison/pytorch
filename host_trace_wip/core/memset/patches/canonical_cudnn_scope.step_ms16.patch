+    def test_a_tensor_map_parameter_is_never_zeroed(self):
+        # a cuBLAS nvjet kernel takes its operands' TMA descriptors (CUtensorMaps, 128 bytes at a 64-byte aligned
+        # offset) as parameters: a word of the map that reads as a stale address's high half is the map's encoding, and
+        # zeroed (stale high halves, _canonical) the kernel's TMA store traps with an illegal instruction (Flash-Next,
+        # 10-16). A real map, after a 16-byte struct of a stale high half: the struct's half is zeroed, the map kept
+        from cuda.bindings import driver
+
+        from torch.cuda._utils import _check_cuda_bindings
+
+        x = torch.zeros(256, 256, device="cuda", dtype=torch.bfloat16)
+        cu = driver.CUtensorMapDataType.CU_TENSOR_MAP_DATA_TYPE_BFLOAT16
+        tmap = _check_cuda_bindings(
+            driver.cuTensorMapEncodeTiled(
+                cu, 2, x.data_ptr(), [driver.cuuint64_t(256)] * 2, [driver.cuuint64_t(512)], [driver.cuuint32_t(64)] * 2, [driver.cuuint32_t(1)] * 2,
+                driver.CUtensorMapInterleave.CU_TENSOR_MAP_INTERLEAVE_NONE,
+                driver.CUtensorMapSwizzle.CU_TENSOR_MAP_SWIZZLE_128B,
+                driver.CUtensorMapL2promotion.CU_TENSOR_MAP_L2_PROMOTION_NONE,
+                driver.CUtensorMapFloatOOBfill.CU_TENSOR_MAP_FLOAT_OOB_FILL_NONE,
+            )
+        )
+        map_bytes = b"".join(int(w).to_bytes(8, "little") for w in tmap.opaque)
+        self.assertEqual(len(map_bytes), 128)
+        self.assertTrue(any(int.from_bytes(map_bytes[o : o + 8], "little") >> 32 for o in range(0, 128, 8)))
+        struct = (0xFF11_0000_0020).to_bytes(8, "little") + bytes(8)
+        kernel = OpaqueKernel(0, (1, 1, 1), (1, 1, 1), 0, (), ((0, 16), (64, 128)), (struct, map_bytes), (), ())
+        b = harvest._canonical(OpaqueBinding((kernel,), ()), lambda q: True)
+        n = b.nodes[0]
+        self.assertEqual(int.from_bytes(n.images[0][:8], "little"), 0x20)
+        self.assertEqual(n.images[1], map_bytes)
+
+    def test_a_cublas_binding_is_never_canonical(self):
+        # _canonical zeroes stale-looking high halves of constant words, for cuDNN's heap-built parameter structs; a
+        # cuBLAS binding's constants are its own (an nvjet kernel's tensor maps among them): it never runs on one
+        calls = []
+        real = harvest._canonical
+
+        def spy(binding, *args, **kwargs):
+            calls.append(binding)
+            return real(binding, *args, **kwargs)
+
+        p = HarvestProvider()
+        a, b = (torch.randn(*s, device="cuda", dtype=torch.bfloat16) for s in ((64, 512), (512, 256)))
+        with mock.patch.object(harvest, "_canonical", spy):
+            binding, why = _learn(p, aten.mm.default, (a, b))
+        self.assertIsNotNone(binding, why)
+        self.assertEqual(calls, [])
+
