+    # a kernel parameter shaped as a CUtensorMap (128 bytes at a 64-byte aligned offset): a TMA descriptor the library
+    # encoded, as cuBLAS's nvjet kernels take them
+    offset, size = param
+    return size == 128 and offset % 64 == 0
