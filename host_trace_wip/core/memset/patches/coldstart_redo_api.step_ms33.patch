+            found += [*m.parameters(recurse=False), *m.buffers(recurse=False)]
+            for v in vars(m).values():
+                items = v if isinstance(v, (list, tuple)) else (v,)
+                found += [x for x in items if isinstance(x, torch.Tensor)]
+    return Closure(found)
