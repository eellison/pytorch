+            if reader == "user scalar":
+                return a, y + STASH["n"]
+            return a, y * 2 if STASH["n"] > 16 else y * 3
+
+        self.addCleanup(STASH.__setitem__, "n", 0)
+        r = HostTraceReplay(step, redo_policy=policy)
