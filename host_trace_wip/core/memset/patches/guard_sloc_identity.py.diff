+class TestGuardSloc(TestCase):
+    def test_equal_code_in_two_files_gives_each_its_site(self):
+        # a guard's provenance is the recording code's own line: two code objects
+        # that compare equal (the same source compiled under two file names)
+        # give their own sites
+        src = "def record():\n    return guard_sloc()\n"
+        sites = []
+        for name in ("/tmp/model_a/layers.py", "/tmp/model_b/layers.py"):
+            ns = {"guard_sloc": _ir.guard_sloc}
+            exec(compile(src, name, "exec"), ns)
+            sites.append(ns["record"]().maybe_user_loc)
+        self.assertEqual(sites, ["model_a/layers.py:2", "model_b/layers.py:2"])
