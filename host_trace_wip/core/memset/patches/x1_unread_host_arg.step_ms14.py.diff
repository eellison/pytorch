+@unittest.skipIf(not TEST_CUDA, "requires CUDA")
+class TestUnreadHostArgument(TestCase):
+    """An unpinned CPU argument (vLLM's per-request metadata on the host): its
+    sizes are the call's, no copy of it is made and nothing the trace records
+    reads its bytes; an op that reads them runs as an eager step."""
+
+    def test_its_sizes_alone_take_one_trace_and_no_copy(self):
+        def fn(x, nums):
+            return x[: nums.shape[0]] * 2
+
+        f = HostTraceReplay(fn)
+        x = torch.randn(64, device="cuda")
+        for n in (3, 7, 1, 12, 7):
+            nums = torch.arange(n, dtype=torch.int32)
+            self.assertEqual(f(x, nums), fn(x, nums), atol=0, rtol=0)
+        self.assertEqual((f.traces, f.eager, len(f.variants)), (1, 0, 1))
+        (v,) = f.variants
+        self.assertEqual([r for _, r in v.tape.launches if isinstance(r, (EagerCall, Memcpy))], [])
+
+    def test_an_op_reading_it_is_an_eager_step_on_the_callers_bytes(self):
+        # nums.to(device) reads the bytes: an eager step at each replay, so the caller's in-place writes between calls
+        # are what it copies
+        def fn(x, nums):
+            return x[: nums.shape[0]] * nums.to(x.device)
+
+        f = HostTraceReplay(fn)
+        x = torch.randn(64, device="cuda")
+        for n in (3, 7, 1, 12):
+            nums = torch.arange(n, dtype=torch.int32)
+            for _ in range(2):
+                self.assertEqual(f(x, nums), fn(x, nums), atol=0, rtol=0)
+                nums.mul_(3).add_(1)
+        self.assertEqual(f.traces, 1)
+        (v,) = f.variants
+        (call,) = [r for _, r in v.tape.launches if isinstance(r, EagerCall)]
+        self.assertIn("reads the storage of p1, an unpinned CPU argument the trace keeps unread", call.reason)
+
+
 instantiate_parametrized_tests(TestPinnedMemcpy)
 
 
