+void HostTraceProgram::reading_bits(
+    uint32_t leaf,
+    const std::vector<uint32_t>& rows,
+    std::vector<uint64_t>& bits) const {
+  bits.assign((rows.size() + 63) / 64, 0);
+  std::vector<bool> reads(rows_.size(), false);
+  for (size_t p = 0; p < rows.size(); ++p) {
+    const uint32_t i = rows[p];
+    const Row& row = rows_[i];
+    const int64_t* x = operands_.data() + row.first;
+    bool r = false;
+    if (row.op == Op::Leaf) {
+      r = static_cast<uint32_t>(x[0]) == leaf;
+    } else if (row.op != Op::Constant) {
+      for (uint32_t k = 0; k < row.count && !r; ++k) {
+        r = reads[x[k]];
+      }
+    }
+    reads[i] = r;
+    if (r) {
+      bits[p / 64] |= uint64_t{1} << (p % 64);
+    }
+  }
+}
