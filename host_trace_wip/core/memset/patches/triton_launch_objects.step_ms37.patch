+@dataclass(frozen=True)
+class _Launcher:
+    """JITFunction.run's launch of the binary, with no hooks (_launch declined them). An object, not a closure: a function or
+    a cell is nothing _host_trace_replay._gc_untrack seals, and would keep the launch it witnesses and its lowering tracked."""
