+def _site_signature(site: Any, signatures: dict[Any, int]) -> int:
+    # a lowered keyed site's key but for its ints, numbered (an unhashable
+    # scalar: the site alone)
+    try:
+        static = (site.site.op, site.dtypes, site.ranks, site.site.scalars, site.device, site.site.state, site.alias)
+        hash(static)
+    except TypeError:
+        static = ("site", id(site))
+    return signatures.setdefault(static, len(signatures))
+
+
+class _KeyProgram:
+    """The rows of a lowered tape that its keyed sites' keys, its validity and
+    its selectors read, with each row that reads none of the `moved` inputs
+    folded to its value at a template call: warm_up evaluates these alone at
+    each point, and the sites that read the same rows at the same signature
+    once. The argument overlap check is not evaluated (a call the native
+    evaluation would refuse for an overlap learns its keys all the same)."""
+
+    def __init__(self, compiled: Any, valid: int, predicates: list[int], groups: list[tuple[int, tuple[int, ...]]]) -> None:
+        self.compiled = compiled
+        self.valid = valid
+        self.predicates = predicates
+        self.groups = groups  # (a site, its key's rows here) per distinct key formula
+        self.getters = [(i, operator.itemgetter(*rows) if len(rows) > 1 else lambda v, r=rows: tuple(v[j] for j in r)) for i, rows in groups]
+
+    @staticmethod
+    def of(lowered: Any, template: tuple, moved: set[int]) -> _KeyProgram | None:
+        result = lowered.compiled.evaluate_inputs(template)
+        if result is None or result[0] != Status.SUCCESS:
+            return None
+        values = result[1]
+        rows = lowered.program.instructions
+        leaf = ("boxed", "pointer", "storage_offset", "size", "stride")
+        reads = [False] * len(rows)
+        for i, row in enumerate(rows):
+            if row[0] in leaf:
+                reads[i] = row[1] in moved
+            elif row[0] != "constant":
+                reads[i] = any(reads[j] for j in row[1:])
+        targets = [lowered.valid, *(s.predicate for s in lowered.selectors), *(r for site in lowered.sites for r in site.rows)]
+        keep: set[int] = set()
+        stack = list(targets)
+        while stack:
+            i = stack.pop()
+            if i not in keep:
+                keep.add(i)
+                if reads[i] and rows[i][0] not in leaf:
+                    stack.extend(rows[i][1:])
+        order = sorted(keep)
+        at = {i: j for j, i in enumerate(order)}
+        spec = [rows[i] if rows[i][0] in leaf and reads[i] else (rows[i][0], *(at[j] for j in rows[i][1:])) if reads[i] else ("constant", values[i]) for i in order]
+        groups: dict[tuple, tuple[int, tuple[int, ...]]] = {}
+        signatures: dict[Any, int] = {}
+        for i, site in enumerate(lowered.sites):
+            here = tuple(at[r] for r in site.rows)
+            groups.setdefault((_site_signature(site, signatures), here), (i, here))
+        return _KeyProgram(
+            torch._C._HostTraceProgram(spec, len(template)),
+            at[lowered.valid],
+            [at[s.predicate] for s in lowered.selectors],
+            list(groups.values()),
+        )
+
+    def keys(self, call: tuple) -> list[tuple[int, tuple[int, ...]]] | None:
+        """Per distinct key formula (a site, its key) at `call`; [] when the
+        variant does not hold there; None when a selector's own guards do
+        not hold (which entry it takes is the native evaluation's)."""
+        result = self.compiled.evaluate_inputs(call)
+        if result is None or result[0] != Status.SUCCESS or result[1][self.valid] != 1:
+            return []
+        values = result[1]
+        if any(values[p] != 1 for p in self.predicates):
+            return None
+        return [(i, get(values)) for i, get in self.getters]
+
+
+@dataclass
+class WarmUp:
+    """What HostTraceReplay.warm_up did: the calls its ranges declare, how many
+    of them a variant holds (the rest would trace), the distinct keys of those,
+    and how many it learned or found refused (the rest were bound)."""
+
+    calls: int
+    symbols: int
+    held: int = 0
+    keys: int = 0
+    learned: int = 0
+    refused: int = 0
+    seconds: float = 0.0
+
+
+def _resized(args: tuple, sizes: dict[tuple[int, int | None], int]) -> tuple:
+    """args with the (argument, dim) sizes given, each resized argument a view
+    at its address that owns nothing (its contents are never read): strides
+    of a contiguous argument follow its sizes, others keep theirs. An int
+    argument (dim None) moves by the value given (its symbol's change)."""
+    from torch._prims_common import make_contiguous_strides_for
+
+    out = list(args)
+    for (a, d), delta in sizes.items():
+        if d is None:
+            out[a] = args[a] + delta
+    for a in {a for a, d in sizes if d is not None}:
+        t = args[a]
+        shape = list(t.shape)
+        for (b, d), n in sizes.items():
+            if b == a and d is not None:
+                shape[d] = n
+        strides = make_contiguous_strides_for(shape) if t.is_contiguous() else t.stride()
+        span = 1 + sum((n - 1) * st for n, st in zip(shape, strides)) if all(shape) else 0
+        storage = torch._C._construct_storage_from_data_pointer(
+            t.untyped_storage().data_ptr(), t.device, (t.storage_offset() + span) * t.element_size()
+        )
+        out[a] = torch.empty(0, dtype=t.dtype, device=t.device).set_(storage, t.storage_offset(), shape, strides)
+    return tuple(out)
+
+
