+            self._warmed.append((tuple(tuple(a.shape) if isinstance(a, torch.Tensor) else None for a in args), {n: tuple(dims[n]) for n in names}, {n: range(min(v), max(v) + 1) for n, v in zip(names, values_of)}))
+        report.seconds = time.perf_counter() - start
