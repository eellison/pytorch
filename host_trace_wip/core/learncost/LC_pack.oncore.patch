+void HostTraceVariant::pack_changed(
+    KernelRow& k,
+    const int64_t* v,
+    const int64_t* bases) {
+  if (k.pack_gen != pack_gen_) {
+    pack(k, v, bases, k.image);
+    k.dynamic_fields.clear();
+    for (size_t i = 0; i < k.field_count; ++i) {
+      const Field& f = k.fields[i];
+      if (f.width != 0 && (f.base >= 0 || row_dynamic_[f.row])) {
+        k.dynamic_fields.push_back(static_cast<uint32_t>(i));
+      }
+    }
+    k.pack_gen = pack_gen_;
+    return;
+  }
+  for (uint32_t i : k.dynamic_fields) {
+    pack_field(k, k.fields[i], v, bases, k.image);
+  }
+  for (size_t i = 0; i < k.descriptor_count; ++i) {
+    encode(k, k.descriptors[i], v, bases, k.image);
+  }
+}
