     @parametrize("direction", ["h2d", "d2h"])
+    def test_a_copy_replays_on_the_trace_calls_tensors(self, direction):
+        # F26's pinned form: a host copy between arguments, replayed on the
+        # tensors the trace call ran on, with new host contents each call
+        def f(d, h):
+            if direction == "h2d":
+                d[::3].copy_(h, non_blocking=True)
+                return d * 2
+            h.copy_(d[::3], non_blocking=True)
+            return d + 1
+
+        r = HostTraceReplay(f)
+        d, h = torch.zeros(2, 64, 35, device="cuda"), torch.zeros(1, 64, 35, pin_memory=True)
+        for k in range(4):
+            if direction == "h2d":
+                h.copy_(torch.full_like(h, float(k + 1)))
+            else:
+                d.fill_(float(k + 1))
+            want_d, want_h = d.clone(), h.clone()
+            want = f(want_d, want_h)
+            torch.cuda.synchronize()
+            out = r(d, h)
+            torch.cuda.synchronize()
+            self.assertEqual(out, want, atol=0, rtol=0)
+            self.assertEqual((d, h), (want_d, want_h), atol=0, rtol=0)
+        self.assertEqual((r.traces, r.replays, r.eager), (1, 3, 0))
+
