+    @parametrize("case", ["copy_only", "copy_row", "no_mm", "full"])
+    def test_a_copy_into_an_argument_replays_on_the_trace_calls_tensors(self, case):
+        # F26: a copy_ into an argument is a memcpy node, captured between
+        # scratch operands. Replays on the tensors the trace call ran on (its
+        # operands at the traced addresses) must still set the node at its
+        # first replay, which a node held at the traced values would skip
+        def fn(a0, a1):
+            v = a1 @ a1.t() if case == "full" else None
+            if case != "copy_only":
+                torch.add(a1, 1, out=a1)
+            (a0[0] if case == "copy_row" else a0[::3]).copy_(a1)
+            return v.t() @ v if case == "full" else a1.sum()
+
+        def mk(seed):
+            g = torch.Generator(device="cuda").manual_seed(seed)
+            return torch.randn(2, 64, 35, device="cuda", generator=g), torch.randn(64, 35, device="cuda", generator=g)
+
+        # this file's HostTraceReplay traces at its first call: calls 1-4
+        # replay on the trace call's tensors
+        r = HostTraceReplay(fn)
+        args = mk(1)
+        for _ in range(5):
+            want_args = tuple(a.clone() for a in args)
+            want = fn(*want_args)
+            self.assertEqual(r(*args), want, atol=0, rtol=0)
+            for a, w in zip(args, want_args):
+                self.assertEqual(a, w, atol=0, rtol=0)
+        self.assertEqual((r.traces, r.replays, r.eager), (1, 4, 0))
+
