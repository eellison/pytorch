+std::vector<int64_t> HostTraceVariant::copy_key(
+    const Segment& run,
+    const Frame& frame) const {
+  std::vector<int64_t> key;
+  key.reserve(run.key_rows.size() + run.key_bases.size() + run.sites.size());
+  for (uint32_t row : run.key_rows) {
+    key.push_back(frame.values[row]);
+  }
+  for (uint32_t b : run.key_bases) {
+    key.push_back(frame.bases[b]);
+  }
+  for (size_t s : run.sites) {
+    key.push_back(frame.site_entries[s]);
+  }
+  return key;
+}
+
+void HostTraceVariant::switch_copy(Segment& run, size_t form, size_t j) {
+  // the records', then the current form's pieces' held parameters
+  auto slots = [&](size_t f) {
+    std::vector<Record*> out;
+    for (size_t i = run.first; i < run.stop; ++i) {
+      out.push_back(&records_[i]);
+    }
+    if (f != 0) {
+      for (Record& r : run.clones[f - 1].pieces) {
+        out.push_back(&r);
+      }
+    }
+    return out;
+  };
+  std::vector<Record*> current = slots(run.form);
+  auto& saved = run.copies[run.form][run.copy].held;
+  saved.resize(current.size());
+  for (size_t i = 0; i < current.size(); ++i) {
+    const Record& r = *current[i];
+    Segment::CopyHeld& h = saved[i];
+    h.held = r.held;
+    h.row = r.held_row;
+    h.dims = r.held_dims;
+    h.memset = r.held_memset;
+    h.copy = r.held_copy;
+    h.image.clear();
+    if (r.held && r.kind == Kind::Kernel) {
+      const KernelRow& k = kernel_row(r, r.held_row);
+      h.image.assign(k.held, k.held + k.nbytes);
+    }
+  }
+  run.form = form;
+  run.copy = j;
+  std::vector<Record*> next = slots(form);
+  const auto& held = run.copies[form][j].held;
+  for (size_t i = 0; i < next.size(); ++i) {
+    Record& r = *next[i];
+    if (i >= held.size()) {
+      r.held = false; // a new copy: its nodes hold the capture's parameters
+      continue;
+    }
+    const Segment::CopyHeld& h = held[i];
+    r.held = h.held;
+    r.held_row = h.row;
+    r.held_dims = h.dims;
+    r.held_memset = h.memset;
+    r.held_copy = h.copy;
+    if (h.held && r.kind == Kind::Kernel) {
+      std::memcpy(kernel_row(r, h.row).held, h.image.data(), h.image.size());
+    }
+  }
+  ++exec_copy_switches;
+}
+
+HostTraceVariant::Segment::Copy* HostTraceVariant::select_copy(
+    Segment& run,
+    size_t form,
+    const Frame& frame) {
+  std::vector<int64_t> key = copy_key(run, frame);
+  if (run.copies.size() < run.execs.size()) {
+    run.copies.resize(run.execs.size());
+  }
+  // each form's own exec is its copy 0 (the current form's too: switch_copy saves into it)
+  for (size_t f : {form, run.form}) {
+    if (run.copies[f].empty()) {
+      run.copies[f].push_back({run.execs[f], {}, {}, false});
+    }
+  }
+  auto& list = run.copies[form];
+  const bool same = run.form == form;
+  // the copy whose values differ from the call's in the fewest entries; the
+  // current one wins a tie (its records are marked against the last call)
+  auto distance = [&](const Segment::Copy& c, size_t bound) {
+    if (!c.keyed || c.key.size() != key.size()) {
+      return bound;
+    }
+    size_t d = 0;
+    for (size_t i = 0; i < key.size() && d < bound; ++i) {
+      d += c.key[i] != key[i];
+    }
+    return d;
+  };
+  const size_t none = key.size() + 1;
+  size_t j = same ? run.copy : list.size();
+  size_t best = same ? distance(list[run.copy], none) : none;
+  for (size_t c = 0; c < list.size() && best > 0; ++c) {
+    if (!(same && c == run.copy)) {
+      const size_t d = distance(list[c], best);
+      if (d < best) {
+        j = c;
+        best = d;
+      }
+    }
+  }
+  if (best > 0 && list.size() < exec_copies) {
+    // values no copy holds: a new instantiation keeps the others' values
+    cudaGraphExec_t e = nullptr;
+    const cudaGraph_t graph = form == 0
+        ? run.native->raw_cuda_graph()
+        : reinterpret_cast<cudaGraph_t>(run.clones[form - 1].graph);
+    C10_CUDA_CHECK(cudaGraphInstantiate(&e, graph, 0));
+    C10_CUDA_CHECK(cudaGraphUpload(e, at::cuda::getCurrentCUDAStream()));
+    list.push_back({reinterpret_cast<CUgraphExec>(e), {}, {}, false});
+    j = list.size() - 1;
+  } else if (j == list.size()) {
+    // another form's call and no keyed copy of this one: its own exec
+    j = 0;
+  }
+  if (!same || j != run.copy) {
+    const std::vector<int64_t> held = list[j].keyed ? list[j].key : std::vector<int64_t>();
+    switch_copy(run, form, j);
+    // the records whose rows, bases or site rows differ from what the copy
+    // holds, and those patched every replay
+    for (size_t i = run.first; i < run.stop; ++i) {
+      dirty_[i] = held.empty() ? 1 : always_[i];
+    }
+    if (!held.empty()) {
+      auto mark_here = [&](const std::vector<uint32_t>& first, const std::vector<uint32_t>& records, size_t x) {
+        for (uint32_t k = first[x]; k < first[x + 1]; ++k) {
+          if (records[k] >= run.first && records[k] < run.stop) {
+            dirty_[records[k]] = 1;
+          }
+        }
+      };
+      size_t i = 0;
+      for (uint32_t row : run.key_rows) {
+        if (held[i] != key[i]) {
+          mark_here(users_.row_first, users_.row_records, row);
+        }
+        ++i;
+      }
+      for (uint32_t b : run.key_bases) {
+        if (held[i] != key[i]) {
+          mark_here(users_.base_first, users_.base_records, b);
+        }
+        ++i;
+      }
+      for (size_t s : run.sites) {
+        if (held[i] != key[i]) {
+          for (size_t r : sites_[s].records) {
+            dirty_[r] = 1;
+          }
+        }
+        ++i;
+      }
+    }
+    exec_copy_hits += !held.empty() && held == key;
+  }
+  Segment::Copy& copy = list[run.copy];
+  copy.keyed = false; // until its patches all succeed
+  copy.key = std::move(key);
+  return &copy;
+}
