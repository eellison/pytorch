+    Site::Reads& r = s.reads[i];
+    r.always |= k.rng_increment != 0 || !k.rng.empty() || !k.cpu_scalars.empty();
+    for (size_t j = 0; j < k.field_count; ++j) {
+      const std::pair<int64_t, int64_t> f{k.fields[j].row, k.fields[j].base};
