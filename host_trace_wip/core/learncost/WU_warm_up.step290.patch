+    def warm_up(self, args: tuple, dims: dict[str, Sequence[tuple[int, int]]], ranges: dict[str, Iterable[int]]) -> WarmUp:
+        """Learns ahead of time the opaque keys (cuBLAS, cuDNN, extern calls)
+        of every call that differs from `args`, a call of a class this entry
+        has traced, only in the sizes `dims` names: per symbol, its (argument,
+        dim) pairs, which take each value of its range in `ranges` together
+        (several symbols: every combination); a pair (argument, None) is an int
+        argument that moves with its symbol (num_prefill_tokens = T - decodes). Each such call's keys come from
+        evaluating its variant's program on views of `args` at those sizes (no
+        kernel runs and nothing is read; a contiguous argument's strides follow
+        its sizes), deduplicated across sites and calls, and each new one is
+        learned as a miss would learn it (_learn). Afterwards a call inside a
+        declaration that still learns is counted in warm_up_misses. A call
+        outside every declaration learns as before."""
+        names = list(ranges)
+        if set(names) != set(dims):
+            raise ValueError(f"host_trace: warm_up's dims {sorted(dims)} and ranges {sorted(ranges)} name other symbols")
+        values_of = [list(ranges[n]) for n in names]
+        start = time.perf_counter()
+        report = WarmUp(calls=math.prod(map(len, values_of)), symbols=len(names))
+        contract = () if self.trusted is not None else argument_contract(args, self.check_global_state)
+        with self._lock, _gc_hold:
+            family = [v for v in self._families.get(contract, ()) if not v.learns]
+            if not family:
+                raise ValueError("host_trace: warm_up needs a traced call of the arguments' class")
+            # per (variant, site), the key values seen: the site's distinct keys
+            keys: dict[OpaqueKey, tuple[_Variant, int]] = {}
+            # each symbol's value at `args`: its first tensor dim's size
+            traced = {n: next(args[a].shape[d] for a, d in dims[n] if d is not None) for n in names}
+            for point in itertools.product(*values_of):
+                call = _resized(args, {(a, d): v - traced[n] if d is None else v for n, v in zip(names, point) for a, d in dims[n]})
+                for variant in family:
+                    evaluated = variant.native.evaluate(call)
+                    if evaluated is None or evaluated[3]:
+                        continue
+                    sites = variant.captured.lowered.sites
+                    for i, key in evaluated[1]:
+                        keys.setdefault(sites[i].key(key), (variant, i))
+                    report.held += 1
+                    break
+            report.keys = len(keys)
+            for key, (variant, i) in keys.items():
+                site = variant.captured.lowered.sites[i].site
+                if site.provider.bind(key) is not None:
+                    continue
+                if site.rng or site.call is None or site.provider.refusal(key) is not None:
+                    report.refused += 1
+                    continue
+                if self._learn(site.op, site.provider, site.call, key) is None:
+                    report.refused += 1
+                else:
+                    report.learned += 1
+            self._warmed.append((tuple(tuple(a.shape) if isinstance(a, torch.Tensor) else None for a in args), {n: tuple(dims[n]) for n in names}, {n: range(min(v), max(v) + 1) for n, v in zip(names, values_of)}))
+        report.seconds = time.perf_counter() - start
+        return report
+
+    def _inside_warm_up(self, args: tuple) -> bool:
+        # whether a declaration covers the call: its sizes are the declaration's
+        # but for the declared dims, each symbol's at one value in its range
+        for shapes, dims, ranges in self._warmed:
+            if len(shapes) != len(args):
+                continue
+            sizes = [list(a.shape) if isinstance(a, torch.Tensor) else None for a in args]
+            ok = True
+            for name, pairs in dims.items():
+                seen = set()
+                for a, d in pairs:
+                    if d is None:
+                        continue
+                    if sizes[a] is None or shapes[a] is None or d >= len(sizes[a]):
+                        ok = False
+                        break
+                    seen.add(sizes[a][d])
+                    sizes[a][d] = shapes[a][d]
+                ok = ok and len(seen) == 1 and next(iter(seen)) in ranges[name]
+            if ok and all((s is None) == (t is None) and (s is None or tuple(s) == t) for s, t in zip(sizes, shapes)):
+                return True
+        return False
