+@dataclass
+class WarmUp:
+    """What HostTraceReplay.warm_up did: the calls its ranges declare, how many
+    of them a variant holds (the rest would trace), the distinct keys of those,
+    and how many it learned or found refused (the rest were bound)."""
+
+    calls: int
+    symbols: int
+    held: int = 0
+    keys: int = 0
+    learned: int = 0
+    refused: int = 0
+    seconds: float = 0.0
+
+
+def _resized(args: tuple, sizes: dict[tuple[int, int | None], int]) -> tuple:
+    """args with the (argument, dim) sizes given, each resized argument a view
+    at its address that owns nothing (its contents are never read): strides
+    of a contiguous argument follow its sizes, others keep theirs. An int
+    argument (dim None) moves by the value given (its symbol's change)."""
+    from torch._prims_common import make_contiguous_strides_for
+
+    out = list(args)
+    for (a, d), delta in sizes.items():
+        if d is None:
+            out[a] = args[a] + delta
+    for a in {a for a, d in sizes if d is not None}:
+        t = args[a]
+        shape = list(t.shape)
+        for (b, d), n in sizes.items():
+            if b == a and d is not None:
+                shape[d] = n
+        strides = make_contiguous_strides_for(shape) if t.is_contiguous() else t.stride()
+        span = 1 + sum((n - 1) * st for n, st in zip(shape, strides)) if all(shape) else 0
+        storage = torch._C._construct_storage_from_data_pointer(
+            t.untyped_storage().data_ptr(), t.device, (t.storage_offset() + span) * t.element_size()
+        )
+        out[a] = torch.empty(0, dtype=t.dtype, device=t.device).set_(storage, t.storage_offset(), shape, strides)
+    return tuple(out)
+
+
