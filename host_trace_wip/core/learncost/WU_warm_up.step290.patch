+    def test_warm_up_learns_a_range_ahead(self):
+        # warm_up over x's rows in [33, 80], after one trace: each key a call in
+        # the range needs is learned once (two GEMM sites of one key are one
+        # entry); calls in the range then learn nothing, a call outside learns
+        # as before
+        def f(x, w):
+            return torch.mm(torch.mm(x, w), w) + 1
+
+        w = torch.randn(64, 64, device="cuda", dtype=bf16) * 0.1
+        r = HostTraceReplay(f, opaque=(HarvestProvider(),))
+        x = torch.randn(32, 64, device="cuda", dtype=bf16)
+        for _ in range(2):
+            self.assertEqual(r(x, w), f(x, w), atol=0, rtol=0)
+        report = r.warm_up((x, w), {"n": [(0, 0)]}, {"n": range(33, 81)})
+        self.assertEqual((report.calls, report.held, report.keys, report.learned, report.refused), (48, 48, 48, 48, 0))
+        learned = r.learned
+        for t in (40, 80, 33, 57, 81):
+            y = torch.randn(t, 64, device="cuda", dtype=bf16)
+            self.assertEqual(r(y, w), f(y, w), atol=0, rtol=0)
+        self.assertEqual((r.learned - learned, r.warm_up_misses, r.traces), (1, 0, 1))
+        # a second warm-up of the range finds every key bound
+        again = r.warm_up((x, w), {"n": [(0, 0)]}, {"n": range(33, 81)})
+        self.assertEqual(again.learned, 0)
+
