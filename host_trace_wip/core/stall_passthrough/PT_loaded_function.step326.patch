+    def test_a_loaded_function_outside_a_trace_is_tvm_ffis_own_call(self):
+        # no per-call cost for a caller that traces nothing: no __call__ of ours outside a trace
+        from tvm_ffi.core import Function
+
+        with tempfile.TemporaryDirectory() as d:
+            add = cute.runtime.load_module(self._export(self.add, d), enable_tvm_ffi=True).func
+        self.assertIsInstance(add, Function)
+        self.assertIs(type(add).__call__, Function.__call__)
+        a, b = torch.randn(1000, device="cuda"), torch.randn(1000, device="cuda")
+        c = torch.empty_like(a)
+        add(a, b, c, 1000)
+        self.assertEqual(c, a + b, atol=0, rtol=0)
+
+        def f(a, b):
+            c = torch.empty_like(a)
+            add(a, b, c, a.shape[0])
+            return c
+
+        ((_, rec),) = trace(f, (a, b)).launches
+        self.assertIsInstance(rec, KernelLaunch)
+        self.assertIs(type(add).__call__, Function.__call__)
+
