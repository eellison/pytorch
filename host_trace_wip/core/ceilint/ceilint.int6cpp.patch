+    def test_float_step_arange_one_trace(self):
+        # XLNet's relative positions: with a symbolic length Inductor sizes the
+        # arange's buffer CeilToInt(FloatTrueDiv(ToFloat(-2*s), -1.0))
+        def fn(x, inv_freq):
+            s = x.shape[1]
+            pos = torch.arange(s, -s, -1.0, dtype=torch.int64, device=x.device).float()
+            sinusoid = torch.einsum("i,d->id", pos, inv_freq)
+            return x.sum(1, keepdim=True) * torch.cat([sinusoid.sin(), sinusoid.cos()], -1).sum(-1)[None, :s]
+
+        inv_freq = 1 / torch.pow(10000, torch.arange(0, 16, 2.0, device="cuda") / 16)
+        compiled = torch.compile(fn, mode="reduce-overhead", dynamic=True)
+        sizes = [64, 32, 48, 17, 100, 32]
+        for s in sizes:
+            x = torch.randn(4, s, device="cuda")
+            self.assertEqual(compiled(x, inv_freq), fn(x, inv_freq))
+        (installation,) = self.installed
+        replay = installation.replay
+        self.assertEqual(replay.declines, [])
+        self.assertEqual((replay.traces, replay.replays, replay.eager), (1, len(sizes) - 2, 1))
