+    def test_ir_floor_of_an_int_ratio_is_not_floordiv(self):
+        # math.floor(x / 3.0) floors a rounded double and x // 3 is exact:
+        # past 2**53 they differ, so the first misses there, as its export does
+        E = 2**53
+        self.assertNotEqual(math.floor(float(E + 1) / 3.0), (E + 1) // 3)
+        env = _ir.Env()
+        x = env.symbol(7, "x")
+        node, symbol = x.node.node, env.export.symbol(x.node.node.args[0])
+        for v, exact in ((math.floor(x / 3.0), False), (x // 3, True)):
+            n = v.node.node
+            lowerings = [
+                lambda p: IRLowering(p, {node: ("boxed", 0)}, env.ctx).lower(n),
+                lambda p: Lowering(p, {symbol: ("boxed", 0)}).lower(env.export.expr(n)),
+            ]
+            for lower in lowerings:
+                program = IntegerProgram([7])
+                row = lower(program)
+                compiled = compile_program(program)
+                for xv in (7, -7, 0, E - 1, -(E - 1), E + 1, -(E + 1)):
+                    status, outputs = compiled.evaluate_inputs((xv,))
+                    if not exact and abs(xv) >= E:
+                        self.assertNotEqual(status, Status.SUCCESS, (v, xv))
+                        continue
+                    self.assertEqual(status, Status.SUCCESS, (v, xv))
+                    self.assertEqual(outputs[row], xv // 3 if exact else math.floor(float(xv) / 3.0), (v, xv))
+
