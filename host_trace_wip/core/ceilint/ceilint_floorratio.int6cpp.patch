+    def floorratio(self, a: Node, b: Node) -> Node:
+        # floor(a / b) of integers the host divided as doubles: apart from
+        # floordiv (exact //), as the sympy path keeps FloorToInt(IntTrueDiv(a, b))
+        # apart from FloorDiv; the two differ past 2**53
+        if b.op == "const" and b.args[0] == 0:
+            raise ZeroDivisionError("floorratio by zero")
+        if a.op == "const" and b.op == "const":
+            return self.const(a.args[0] // b.args[0])
+        if b.op == "const" and b.args[0] == 1:
+            return a
+        return self.mk("floorratio", (a, b), a.hint // b.hint)
