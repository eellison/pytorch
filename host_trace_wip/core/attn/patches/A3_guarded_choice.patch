+    def test_a_float_cost_model_choice_dispatches_again_where_it_changes(self):
+        # a launcher's tile choice by a float cost model over n (trtllm-gen's
+        # generation tile, selectTileSizeQForGqaGeneration): choice() guards
+        # the run of n that picks the block, not n, and in a dispatch_unit
+        # those guards are the unit's. A new n inside a run seen replays, a
+        # run first seen dispatches the unit again, no call traces again
+        def cost(n):
+            blocks = {b: -(-n // b) for b in (256, 512, 1024, 2048)}
+            t = {b: -(-k // 132) * (1.0 + 0.37 * b / 256.0) + 0.05 * k for b, k in blocks.items()}
+            return min(t, key=t.get)
+
+        @torch.cuda._host_trace.dispatch_unit
+        def pick(x):
+            n = x.numel()
+            b = torch.cuda._host_trace.choice(n, cost, period=256, top=1 << 17)
+            y = torch.empty_like(x)
+            _add[(triton.cdiv(n, b),)](x, y, n, 1, B=b)
+            return y
+
+        def f(x):
+            return pick(x).sin()
+
+        r = HostTraceReplay(f)
+        # all 1 mod 16: Triton's own specialization of n (% 16, == 1) is fixed
+        sizes = (1009, 1009, 2001, 3825, 3841, 5009, 1505, 20001, 70001, 14833, 4001, 200001, 90001)
+        for n in sizes:
+            x = torch.randn(n, device="cuda")
+            self.assertEqual(r(x), f(x), atol=0, rtol=0)
+        runs = [torch.cuda._host_trace.choice_range(n, cost, 256, 1 << 17) for n in sizes]
+        self.assertEqual([c for c, _, _ in runs], [cost(n) for n in sizes])
+        self.assertEqual(sorted({c for c, _, _ in runs}), [256, 512, 1024, 2048])
+        # the trace is the first call's; each run first seen after it is a redispatch
+        seen, expected = {runs[0][1:]}, 0
+        for _, lo, hi in runs[1:]:
+            expected += (lo, hi) not in seen
+            seen.add((lo, hi))
+        self.assertEqual((r.traces, r.eager, r.redispatches, len(r.variants)), (1, 0, expected, 1))
+
 
