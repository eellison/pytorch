--- a/torch/cuda/_host_trace.py
+++ b/torch/cuda/_host_trace.py
@@ -127,6 +127,42 @@
     return unit
 
 
+def choice_range(x: int, choose: Callable[[int], Any], period: int, top: int | None = None) -> tuple[Any, int, int]:
+    """(choose(x), lo, hi): the run of values lo <= x <= hi around x at which
+    choose decides the same, for a choose constant on each block
+    (period * k, period * (k + 1)] of its argument (x >= 1): one value per
+    block decides it, down to 1 and up to `top`, else up to x's own block."""
+    c = choose(x)
+    k = (x - 1) // period
+    lo, hi = 1, max((k + 1) * period, top or 0)
+    for j in range(k - 1, -1, -1):
+        if choose(j * period + 1) != c:
+            lo = (j + 1) * period + 1
+            break
+    for j in range(k + 1, (hi - 1) // period + 1):
+        if choose(j * period + 1) != c:
+            hi = j * period
+            break
+    return c, lo, hi
+
+
+def choice(x: IntLikeType, choose: Callable[[int], Any], period: int = 1, top: int | None = None) -> Any:
+    """choose(x) for a traced host where choose reads x through arithmetic a
+    trace does not carry (a launcher's float cost model picking a tile): its
+    decision at x's hint, guarded on the run of values that make the same
+    decision (choice_range), not on x's value. In an op's own host (a custom
+    op's or a dispatch_unit's) the guards are the op's: a call outside the run
+    dispatches the op again, and one inside replays, whatever x is."""
+    if isinstance(x, int):
+        return choose(x)
+    from torch.cuda._host_trace_tape import _hint
+
+    c, lo, hi = choice_range(_hint(x), choose, period, top)
+    if (lo > 1 and not bool(x >= lo)) or not bool(x <= hi):
+        raise AssertionError(f"host_trace: {x}'s hint is outside its own choice's run [{lo}, {hi}]")
+    return c
+
+
 # a view's symbolic size-1 dim may take another stride than eager's (it
 # addresses nothing), so the trace does not branch on that size being 1
