+// _host_trace_replay._gc_untrack's walk over the Python objects reachable from `roots`. A type's flags come from
+// classify(type), cached in `kinds`:
+//   GC_DESCEND   its referents (tp_traverse) are walked
+//   GC_IMMUTABLE nothing changes what it refers to once it is made
+//   GC_FINAL     nothing changes what it refers to once the slow call that made it ends
+//   GC_CONTAINER a list, dict or set: final when every reference to it is held by an immutable or final object or
+//                a final container (its reference count says there is no other)
+//   GC_CLEAN     an object of the type may be reached from a sealed one (it reaches no object outside it)
+//   GC_KEEP      never untracked (a tensor)
+// An object is sealed when it is immutable, final or a final container and every referent is sealed, clean or
+// untracked; a sealed object is untracked (PyObject_GC_UnTrack). Nothing an untracked object reaches changes, so it
+// cannot become part of a reference cycle, its reference count frees it as before, and a later walk stops at it.
+constexpr int64_t GC_DESCEND = 1, GC_IMMUTABLE = 2, GC_CLEAN = 4, GC_FINAL = 8, GC_CONTAINER = 16, GC_KEEP = 32;
+
+int collect_referent(PyObject* o, void* arg) {
+  static_cast<std::vector<PyObject*>*>(arg)->push_back(o);
+  return 0;
+}
+
+int64_t gc_untrack(const py::iterable& roots, const py::dict& kinds, const py::function& classify) {
+  std::unordered_map<PyTypeObject*, int64_t> flags_of;
+  auto flags = [&](PyObject* o) {
+    PyTypeObject* t = Py_TYPE(o);
+    auto it = flags_of.find(t);
+    if (it != flags_of.end()) {
+      return it->second;
+    }
+    py::handle type(reinterpret_cast<PyObject*>(t));
+    py::object f = kinds.contains(type) ? py::object(kinds[type]) : py::object(classify(type));
+    kinds[type] = f;
+    return flags_of[t] = f.cast<int64_t>();
+  };
+  struct Node {
+    PyObject* obj;
+    int64_t flags;
+    size_t first = 0, count = 0;  // its referents in `edges`, once walked
+    Py_ssize_t owners = 0;  // references from immutable, final and container nodes
+    int8_t sealed = -1, final = -1;  // -1 unknown
+  };
+  std::vector<Node> nodes;
+  // classify runs Python, which may switch threads: the walk holds what it visits (`held`), and what it is yet to
+  // visit (`pending`, released before reference counts are read)
+  std::vector<py::object> held, pending;
+  std::unordered_map<PyObject*, size_t> index;
+  std::vector<PyObject*> referents;
+  std::vector<size_t> walked;  // nodes whose referents are walked
+  std::vector<PyObject*> raw;  // their referents, resolved into `edges`
+  std::vector<PyObject*> stack;
+  for (py::handle root : roots) {
+    stack.push_back(root.ptr());
+  }
+  while (!stack.empty()) {
+    PyObject* o = stack.back();
+    stack.pop_back();
+    if (!PyObject_IS_GC(o) || index.count(o)) {
+      continue;
+    }
+    held.push_back(py::reinterpret_borrow<py::object>(o));
+    const int64_t f = flags(o);
+    index[o] = nodes.size();
+    nodes.push_back({o, f});
+    Node& n = nodes.back();
+    const bool untrackable = (f & (GC_IMMUTABLE | GC_FINAL)) && !(f & GC_KEEP);
+    if (!(f & GC_DESCEND)) {
+      n.sealed = (f & GC_CLEAN) ? 1 : 0;
+      continue;
+    }
+    if (untrackable && !PyObject_GC_IsTracked(o)) {
+      n.sealed = 1;  // untracked by an earlier walk, or a tuple CPython untracked (nothing tracked in it)
+      continue;
+    }
+    referents.clear();
+    if (Py_TYPE(o)->tp_traverse != nullptr) {
+      Py_TYPE(o)->tp_traverse(o, collect_referent, &referents);
+    }
+    // a traced tensor's symbolic sizes, strides, offset and storage size hold their Python nodes from C++
+    if (THPVariable_Check(o) && THPVariable_Unpack(o).unsafeGetTensorImpl()->has_symbolic_sizes_strides()) {
+      const at::Tensor& t = THPVariable_Unpack(o);
+      const c10::TensorImpl* impl = t.unsafeGetTensorImpl();
+      auto add = [&](const c10::SymInt& s) {
+        if (s.is_heap_allocated()) {
+          if (auto* p = dynamic_cast<torch::impl::PythonSymNodeImpl*>(s.toSymNodeImplUnowned())) {
