+          }
+        }
+      };
+      for (const auto& s : t.sym_sizes()) {
+        add(s);
+      }
+      for (const auto& s : t.sym_strides()) {
+        add(s);
+      }
+      add(t.sym_storage_offset());
+      if (impl->has_storage()) {
+        add(impl->unsafe_storage().sym_nbytes());
+      }
+    }
+    n.first = raw.size();
+    for (PyObject* r : referents) {
+      if (PyObject_IS_GC(r)) {
+        raw.push_back(r);
+        stack.push_back(r);
+        pending.push_back(py::reinterpret_borrow<py::object>(r));
+      }
+    }
+    n.count = raw.size() - n.first;
+    walked.push_back(index[o]);
+  }
+  pending.clear();
+  std::vector<size_t> edges(raw.size());
+  for (size_t i = 0; i < raw.size(); ++i) {
+    edges[i] = index.at(raw[i]);
+  }
+  // per container, the containers referring to it
+  std::unordered_map<size_t, std::vector<size_t>> container_parents;
+  for (size_t p : walked) {
+    const Node& n = nodes[p];
+    if (!(n.flags & (GC_IMMUTABLE | GC_FINAL | GC_CONTAINER))) {
+      continue;
+    }
+    for (size_t e = n.first; e < n.first + n.count; ++e) {
+      nodes[edges[e]].owners++;
+      if (n.flags & GC_CONTAINER) {
+        container_parents[edges[e]].push_back(p);
+      }
+    }
+  }
+  static const std::vector<size_t> no_parents;
+  auto parents_of = [&](size_t i) -> const std::vector<size_t>& {
+    auto it = container_parents.find(i);
+    return it == container_parents.end() ? no_parents : it->second;
+  };
+  // final: over referrers (a container on a cycle of containers is not final)
+  auto is_final = [&](size_t root) {
+    std::vector<std::pair<size_t, size_t>> todo{{root, 0}};
+    std::unordered_set<size_t> open{root};
+    while (!todo.empty()) {
+      auto& [i, k] = todo.back();
+      Node& n = nodes[i];
+      if (!(n.flags & GC_CONTAINER)) {
+        n.final = (n.flags & (GC_IMMUTABLE | GC_FINAL)) ? 1 : 0;
+      }
+      const auto& parents = parents_of(i);
+      if (n.final < 0 && k < parents.size()) {
+        const size_t p = parents[k++];
+        if (nodes[p].final < 0 && !open.count(p)) {
+          open.insert(p);
+          todo.emplace_back(p, 0);
+        }
+        continue;
+      }
+      if (n.final < 0) {
+        bool all = n.owners == Py_REFCNT(n.obj) - 1;  // less `held`'s
+        for (size_t p : parents) {
+          all = all && nodes[p].final == 1;
+        }
+        n.final = all ? 1 : 0;
+      }
+      open.erase(i);
+      todo.pop_back();
+    }
+    return nodes[root].final == 1;
+  };
+  // sealed: over referents (a node on a cycle is not sealed)
+  for (size_t root : walked) {
+    if (nodes[root].sealed >= 0) {
+      continue;
+    }
+    std::vector<std::pair<size_t, size_t>> todo{{root, 0}};
+    std::unordered_set<size_t> open{root};
+    while (!todo.empty()) {
+      auto& [i, k] = todo.back();
+      Node& n = nodes[i];
+      if (k < n.count) {
+        const size_t c = edges[n.first + k++];
+        if (nodes[c].sealed < 0 && !open.count(c)) {
+          open.insert(c);
+          todo.emplace_back(c, 0);
+        }
+        continue;
+      }
+      bool all = true;
+      for (size_t e = n.first; e < n.first + n.count; ++e) {
+        all = all && nodes[edges[e]].sealed == 1;
+      }
+      bool sealed;
+      if (n.flags & (GC_IMMUTABLE | GC_FINAL)) {
+        sealed = all;
+      } else if (n.flags & GC_CONTAINER) {
+        sealed = all && is_final(i);
+      } else {
+        sealed = (n.flags & GC_CLEAN) != 0;
+      }
+      n.sealed = sealed ? 1 : 0;
+      open.erase(i);
+      todo.pop_back();
+    }
+  }
+  int64_t untracked = 0;
+  for (size_t i : walked) {
+    const Node& n = nodes[i];
+    if (n.sealed == 1 && (n.flags & (GC_IMMUTABLE | GC_FINAL | GC_CONTAINER)) && !(n.flags & GC_KEEP) &&
+        PyObject_GC_IsTracked(n.obj)) {
+      PyObject_GC_UnTrack(n.obj);
+      ++untracked;
+    }
+  }
+  return untracked;
+}
