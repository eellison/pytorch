+def _gc_flags(t: type) -> int:
+    """How _gc_untrack treats an object of type t (torch._C._host_trace_gc_untrack).
+    Immutable: tuples, frozensets, IR nodes (hash-consed), IRSymNodes and the
+    Sym* wrappers over them, pytree specs and the host trace's frozen
+    dataclasses without a cached property. Final, nothing writes them once the
+    slow call that made them ends: a tape's records (its inputs, allocations,
+    roots, outputs and ops) and traced tensors (kept tracked); their lists and
+    dicts, held by nothing else, are final too. Clean, reaching no object of a
+    trace's records: types, modules, operators, sympy expressions, and an Env
+    (its IR, guard records and sympy export refer to nothing outside it).
+    Every untracked object's type deallocates through PyObject_GC_UnTrack (its
+    bases heap types or object). Everything else of the host trace's (the
+    tapes, lowerings, programs and variants that folds, redispatches and
+    relowers extend) is walked and stays tracked; anything else is neither."""
+    if t in (tuple, frozenset):
+        return _GC_DESCEND | _GC_IMMUTABLE
+    if t in (list, dict, set):
+        return _GC_DESCEND | _GC_CONTAINER
+    if issubclass(t, (type, types.ModuleType, torch._ops.OpOverload, torch._ops.OpOverloadPacket, sympy.Basic)):
+        return _GC_CLEAN
+    if t is _ir.Env:
+        return _GC_DESCEND | _GC_CLEAN
+    if t is _TracedTensor:
+        return _GC_DESCEND | _GC_FINAL | _GC_KEEP
+    if not all(c is object or c.__flags__ & _HEAPTYPE for c in t.__mro__):
+        return 0
+    if t in (_ir.Node, _ir.IRSymNode, torch.SymInt, torch.SymFloat, torch.SymBool) or issubclass(t, pytree.TreeSpec):
+        return _GC_DESCEND | _GC_IMMUTABLE
+    if t in _GC_RECORDS:
+        return _GC_DESCEND | _GC_FINAL
+    if not t.__module__.startswith("torch.cuda._host_trace"):
+        return 0
+    params = getattr(t, "__dataclass_params__", None)
+    if params is not None and params.frozen and not any(isinstance(v, functools.cached_property) for c in t.__mro__ for v in vars(c).values()):
