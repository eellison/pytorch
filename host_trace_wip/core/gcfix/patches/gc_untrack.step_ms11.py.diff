+# torch._C._host_trace_gc_untrack's flags (_gc_flags)
+_GC_DESCEND, _GC_IMMUTABLE, _GC_CLEAN, _GC_FINAL, _GC_CONTAINER, _GC_KEEP = 1, 2, 4, 8, 16, 32
+# per type, its flags
+_GC_KINDS: dict[type, int] = {}
+_HEAPTYPE = 1 << 9
