+    @parametrize("static", [False, True])
+    @parametrize("custom_op", [False, True])
+    def test_index_select_past_32_bit_indexing(self, custom_op, static):
+        # a view whose span passes 2**31 elements: canUse32BitIndexMath (a guard on
+        # the span) sends index_select to gather_out, whose elementwise kernel is
+        # traced; below 2**31 the same indices take the small-index kernel
+        h, l = 1024, 9
+        raw = torch.randint(0, 256, (2**31 + l * h,), device="cuda", dtype=torch.uint8)
+        pools = {"large": raw.as_strided((3, l, h), (2**30, h, 1)), "small": raw.as_strided((3, l, h), (l * h, h, 1))}
+        kernels = {"large": "_scatter_gather_elementwise_kernel", "small": "indexSelectSmallIndex"}
+
+        self.addCleanup(_CONV_STATE.clear)
+
+        def fn(pool, i):
+            if not custom_op:
+                return pool.transpose(-1, -2)[..., -l:].index_select(0, i)
+            _CONV_STATE["pool"] = pool
+            out = torch.empty(i.shape[0], h, l, device="cuda", dtype=pool.dtype)
+            torch.ops.host_trace_test.select_conv_state(out, i)
+            return out
+
+        entry = HostTraceReplay(fn, static_prefix=int(static))
+        for span, n in (("large", 3), ("large", 5), ("small", 3), ("small", 5), ("large", 2)):
+            args = (pools[span], torch.randint(0, 3, (n,), device="cuda"))
+            tape = trace(fn, args)
+            self.assertFalse([c.reason for _, c in tape.launches if isinstance(c, EagerCall)])
+            with _zero_init():
+                nodes = [node for node in capture_kernel_nodes(lambda s: fn(*args), memcpy=True) if isinstance(node, KernelNode)]
+            self.assertEqual([k for k in kernels.values() if any(k in node.name for node in nodes)], [kernels[span]])
+            self.assertEqual([c.function for _, c in tape.launches if isinstance(c, KernelLaunch)], [node.function for node in nodes])
+            self._assert_replays_bitwise(entry, fn, args)
+        # the span guard flips at each switch: a redispatch of index_select, a new
+        # variant inside the custom op's body
+        self.assertEqual((entry.traces, entry.eager), (1 + custom_op, 0))
+
