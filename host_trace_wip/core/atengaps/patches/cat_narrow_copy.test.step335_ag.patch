+    def test_vstack_of_one_tensor_is_a_memcpy(self):
+        # vLLM's PLE prefill: vstack of its one part, cat_out_cuda's narrow + copy_
+        # loop, whose contiguous copy is a cudaMemcpyAsync
+        def fn(x):
+            return torch.vstack([x])
+
+        entry = HostTraceReplay(fn)
+        for n in (64, 7, 512, 7):
+            x = _randn(n, 1024, dtype=torch.bfloat16)
+            self.assertEqual([type(c) for _, c in trace(fn, (x,)).launches], [Memcpy])
+            self._assert_replays_bitwise(entry, fn, (x,))
+        self.assertEqual((entry.traces, entry.eager), (1, 0))
