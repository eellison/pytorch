+    @parametrize("cap", [0, 2, 8])
+    def test_binding_switches_with_grid_execs(self, cap):
+        # test_binding_switches with an exec per launch configuration: forms
+        # and sizes alternate, each (form, grid) an exec of its own under the cap
+        p = TableProvider(style="mixed")
+        f = HostTraceReplay(mul_chain, opaque=(p,))
+        base = torch.randn(4096, device="cuda")
+        cases = [(512, 0), (640, 0), (512, 4), (640, 4), (1024, 0), (1280, 4)]
+        was = torch._C._host_trace_grid_execs(cap)[0]
+        try:
+            before = torch._C._host_trace_grid_execs(-1)
+            for _ in range(4):
+                for n, offset in cases:
+                    x, y = torch.randn(n, device="cuda"), base[offset : offset + n]
+                    base.normal_()
+                    self.assertEqual(f(x, y), mul_chain(x, y), atol=0, rtol=0)
+            after = torch._C._host_trace_grid_execs(-1)
+        finally:
+            torch._C._host_trace_grid_execs(was)
+        self.assertEqual(len(bound(f)), 1)
+        self.assertEqual(f.eager, 0)
+        self.assertGreater(f.replays, 0)
+        self.assertEqual(after[1] - before[1] > 0, cap > 0)
