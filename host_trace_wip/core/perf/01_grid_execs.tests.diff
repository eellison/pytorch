+    @parametrize("cap", [0, 1, 4])
+    def test_a_launch_configuration_gets_its_own_exec(self, cap):
+        # three grids of one variant, alternating: under the cap each grid gets
+        # an exec of its own, instantiated once (the trace's grid takes the
+        # segment's exec), so a grid change sets no grid in an exec; past the
+        # cap, and at 0, an exec is re-gridded in place
+        f = HostTraceReplay(add)
+        xs = [torch.randn(n, device="cuda") for n in (1000, 3000, 5000)]
+        was = torch._C._host_trace_grid_execs(cap)[0]
+        try:
+            before = torch._C._host_trace_grid_execs(-1)
+            for _ in range(3):
+                for x in xs:
+                    self.assertEqual(f(x), x + 3, atol=0, rtol=0)
+            after = torch._C._host_trace_grid_execs(-1)
+        finally:
+            torch._C._host_trace_grid_execs(was)
+        instantiations, switches = after[1] - before[1], after[2] - before[2]
+        self.assertEqual((len(f.variants), f.traces, f.replays, f.eager), (1, 1, 8, 0))
+        self.assertEqual(instantiations, {0: 0, 1: 1, 4: 2}[cap])
+        self.assertEqual(switches > 0, cap > 0)
+
+    @parametrize("frozen", [False, True])
+    def test_frozen_grid_execs_instantiate_nothing_after_warm_up(self, frozen):
+        # warm up two grids, then a third: frozen, the third re-grids an exec
+        # in place on every replay instead of instantiating one
+        f = HostTraceReplay(add)
+        warm = [torch.randn(n, device="cuda") for n in (1000, 3000)]
+        new = torch.randn(5000, device="cuda")
+        was = torch._C._host_trace_grid_execs(4)[0]
+        was_frozen = torch._C._host_trace_grid_execs_frozen(-1)[0]
+        try:
+            for x in warm + warm:
+                self.assertEqual(f(x), x + 3, atol=0, rtol=0)
+            torch._C._host_trace_grid_execs_frozen(int(frozen))
+            before = torch._C._host_trace_grid_execs(-1)[1], torch._C._host_trace_grid_execs_frozen(-1)[1]
+            for x in [new, new, *warm, new, *warm, new]:
+                self.assertEqual(f(x), x + 3, atol=0, rtol=0)
+            after = torch._C._host_trace_grid_execs(-1)[1], torch._C._host_trace_grid_execs_frozen(-1)[1]
+        finally:
+            torch._C._host_trace_grid_execs(was)
+            torch._C._host_trace_grid_execs_frozen(int(was_frozen))
+        self.assertEqual((len(f.variants), f.traces, f.replays, f.eager), (1, 1, 11, 0))
+        self.assertEqual((after[0] - before[0], after[1] - before[1]), (0, 4) if frozen else (1, 0))
+
