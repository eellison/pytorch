+std::vector<int64_t> HostTraceVariant::launch_config(
+    Segment& run,
+    size_t form,
+    const Frame* frame) {
+  auto* driver = c10::cuda::DriverAPI::get();
+  Segment::Clone* clone = form == 0 ? nullptr : &run.clones[form - 1];
+  std::vector<int64_t> config;
+  auto add = [&](const Record& r, CUgraphNode node) {
+    if (r.kind != Kind::Kernel || !node) {
+      return;
+    }
+    if (!frame) {
+      CUDA_KERNEL_NODE_PARAMS p{};
+      C10_CUDA_DRIVER_CHECK(driver->cuGraphKernelNodeGetParams_(node, &p));
+      config.insert(
+          config.end(),
+          {reinterpret_cast<int64_t>(p.func),
+           p.gridDimX,
+           p.gridDimY,
+           p.gridDimZ,
+           p.blockDimX,
+           p.blockDimY,
+           p.blockDimZ,
+           p.sharedMemBytes});
+      return;
+    }
+    const int64_t row = r.site >= 0 ? frame->site_entries[r.site] : 0;
+    const KernelRow& k = kernel_row(r, row);
+    config.push_back(reinterpret_cast<int64_t>(k.params.func));
+    for (size_t d = 0; d < 7; ++d) {
+      config.push_back(
+          k.constant_dims ? k.dims[d] : frame->values[k.dim_rows[d]]);
+    }
+  };
+  for (size_t i = run.first; i < run.stop; ++i) {
+    add(records_[i], clone ? clone->nodes[i - run.first] : records_[i].node);
+  }
+  if (clone) {
+    for (const Record& r : clone->pieces) {
+      add(r, r.node);
+    }
+  }
+  return config;
+}
+
+CUgraphExec HostTraceVariant::select_grid(
+    Segment& run,
+    const Frame& frame,
+    size_t form) {
+  if (!run.grid_indexed) {
+    for (size_t i = run.first; i < run.stop; ++i) {
+      const Record& r = records_[i];
+      if (r.kind == Kind::Kernel && !r.kernel.constant_dims) {
+        run.grid_rows.insert(
+            run.grid_rows.end(),
+            r.kernel.dim_rows.begin(),
+            r.kernel.dim_rows.end());
+      }
+    }
+    std::sort(run.grid_rows.begin(), run.grid_rows.end());
+    run.grid_rows.erase(
+        std::unique(run.grid_rows.begin(), run.grid_rows.end()),
+        run.grid_rows.end());
+    run.grid_indexed = true;
+  }
+  std::vector<int64_t>& key = run.grid_key;
+  key.clear();
+  key.push_back(static_cast<int64_t>(form));
+  for (int64_t row : run.grid_rows) {
+    key.push_back(frame.values[row]);
+  }
+  for (size_t s : run.sites) {
+    key.push_back(frame.site_entries[s]);
+  }
+  if (run.grid >= 0 && run.grids[run.grid].key == key) {
+    return run.grids[run.grid].exec;
+  }
+  int64_t to = -1;
+  auto it = run.grid_index.find(key);
+  if (it != run.grid_index.end()) {
+    to = static_cast<int64_t>(it->second);
+  } else if (
+      !grid_execs_frozen &&
+      static_cast<int64_t>(run.grids.size()) < grid_exec_cap) {
+    to = static_cast<int64_t>(instantiate_grid(run, frame, form));
+  } else {
+    grid_frozen_misses += grid_execs_frozen;
+    // past the cap: the current exec if of the form, else the form's first,
+    // re-gridded in place
+    for (size_t i = 0; i < run.grids.size() && to < 0; ++i) {
+      if (run.grids[i].form == form) {
+        to = static_cast<int64_t>(i);
+      }
+    }
+    if (run.grid >= 0 && run.grids[run.grid].form == form) {
+      to = run.grid;
+    }
+    if (to < 0) {
+      run.grids.push_back({form, key, run.execs[form], false, {}});
+      to = static_cast<int64_t>(run.grids.size() - 1);
+    }
+  }
+  if (to != run.grid) {
+    switch_grid(run, to);
+  }
+  return run.grids[to].exec;
+}
+
+size_t HostTraceVariant::instantiate_grid(
+    Segment& run,
+    const Frame& frame,
+    size_t form) {
+  run.form_configs.resize(run.execs.size());
+  std::vector<int64_t>& own = run.form_configs[form];
+  bool adopted = false;
+  for (const Segment::Grid& x : run.grids) {
+    adopted = adopted || (!x.owned && x.form == form);
+  }
+  if (!adopted && own.empty()) {
+    // nothing has set the form graph's nodes yet: they hold what its exec
+    // was instantiated at
+    own = launch_config(run, form, nullptr);
+  }
+  const std::vector<int64_t> config = launch_config(run, form, &frame);
+  if (!adopted && config == own) {
+    run.grids.push_back({form, run.grid_key, run.execs[form], false, {}});
+    run.grid_index.emplace(run.grid_key, run.grids.size() - 1);
+    own.clear();
+    return run.grids.size() - 1;
+  }
+  const auto t0 = std::chrono::steady_clock::now();
+  // the form graph's kernel nodes at the frame's configuration; their
+  // parameters are whatever their images hold, patched before the first launch
+  auto* driver = c10::cuda::DriverAPI::get();
+  Segment::Clone* clone = form == 0 ? nullptr : &run.clones[form - 1];
+  auto set = [&](const Record& r, CUgraphNode node) {
+    if (r.kind != Kind::Kernel || !node) {
+      return;
+    }
+    const int64_t row = r.site >= 0 ? frame.site_entries[r.site] : 0;
+    const KernelRow& k = kernel_row(r, row);
+    std::array<int64_t, 7> dims = k.dims;
+    if (!k.constant_dims) {
+      for (size_t d = 0; d < dims.size(); ++d) {
+        dims[d] = frame.values[k.dim_rows[d]];
+      }
+    }
+    for (int64_t d : dims) {
+      TORCH_CHECK_VALUE(
+          d >= 0 && d <= std::numeric_limits<unsigned int>::max(),
+          "host_trace: a launch dimension of ",
+          d);
+    }
+    CUDA_KERNEL_NODE_PARAMS p = k.params;
+    p.gridDimX = static_cast<unsigned int>(dims[0]);
+    p.gridDimY = static_cast<unsigned int>(dims[1]);
+    p.gridDimZ = static_cast<unsigned int>(dims[2]);
+    p.blockDimX = static_cast<unsigned int>(dims[3]);
+    p.blockDimY = static_cast<unsigned int>(dims[4]);
+    p.blockDimZ = static_cast<unsigned int>(dims[5]);
+    p.sharedMemBytes = static_cast<unsigned int>(dims[6]);
+    C10_CUDA_DRIVER_CHECK(driver->cuGraphKernelNodeSetParams_(node, &p));
+  };
+  for (size_t i = run.first; i < run.stop; ++i) {
+    set(records_[i], clone ? clone->nodes[i - run.first] : records_[i].node);
+  }
+  if (clone) {
+    for (const Record& r : clone->pieces) {
+      set(r, r.node);
+    }
+  }
+  cudaGraphExec_t exec = nullptr;
+  // CUDAGraph::instantiate's flags
+  C10_CUDA_CHECK(cudaGraphInstantiateWithFlags(
+      &exec,
+      clone ? reinterpret_cast<cudaGraph_t>(clone->graph)
+            : run.native->raw_cuda_graph(),
+      cudaGraphInstantiateFlagAutoFreeOnLaunch |
+          cudaGraphInstantiateFlagUseNodePriority));
+  run.grids.push_back(
+      {form, run.grid_key, reinterpret_cast<CUgraphExec>(exec), true, {}});
+  run.grid_index.emplace(run.grid_key, run.grids.size() - 1);
+  C10_CUDA_CHECK(cudaGraphUpload(exec, at::cuda::getCurrentCUDAStream()));
+  ++grid_instantiations;
+  grid_instantiate_ns += (std::chrono::steady_clock::now() - t0).count();
+  return run.grids.size() - 1;
+}
+
+void HostTraceVariant::switch_grid(Segment& run, int64_t to) {
+  // the records hold the current exec's state, or with none the form exec's
+  std::vector<Segment::Held> none;
+  std::vector<Segment::Held>& saved =
+      run.grid >= 0 ? run.grids[run.grid].held : none;
+  if (to >= 0) {
+    const Segment::Grid& x = run.grids[to];
+    const bool same = run.grid < 0 && !x.owned && x.form == run.form;
+    swap_held(run, saved, x.form, same ? saved : x.held);
+  } else {
+    // leaving: the form's exec is current from here on and the non-keyed path
+    // patches the form execs, so what any of them held is unknown
+    const bool same = !run.grids[run.grid].owned;
+    swap_held(run, saved, run.form, same ? saved : none);
+    for (Segment::Grid& x : run.grids) {
+      if (!x.owned) {
+        x.held.clear();
+      }
+    }
+    run.form_held.clear();
+  }
+  for (size_t i = run.first; i < run.stop; ++i) {
+    dirty_[i] = 1;
+  }
+  run.grid = to;
+  ++grid_switches;
+}
