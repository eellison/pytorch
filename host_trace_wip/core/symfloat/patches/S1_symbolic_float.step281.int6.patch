+        x = f32(float(v))
+        near = [y for y in (np.nextafter(x, f32(-np.inf)), x, np.nextafter(x, f32(np.inf))) if np.isfinite(y)]
+    return float(min(near, key=lambda y: (abs(Fraction(float(y)) - v), int(np.array(y, np.float32).view(np.uint32)) & 1)))
