+    def test_a_pointwise_op_of_an_eager_output_traces(self):
+        # e1's hint has the low bits of the op's own output allocation (allocation 1): the witness's
+        # host maps an address to its allocation by the whole hint
+        def fn(x, w):
+            x = x * 2
+            a = x @ w
+            return torch.relu(x @ w) + a
+
+        x, w = torch.randn(8, 4, device="cuda"), torch.randn(4, 6, device="cuda")
+        tape = trace(fn, (x, w))
+        self.assertEqual([type(rec).__name__ for _, rec in tape.launches], ["KernelLaunch", "EagerCall", "EagerCall", "KernelLaunch", "KernelLaunch"])
+
