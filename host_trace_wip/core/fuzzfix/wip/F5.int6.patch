+    def test_a_shape_routed_op_guards_its_meta_checks(self):
+        # addmm.out at K = 0 traces as its iterators (out filled from bias), none of which reads
+        # mat2, whose size the host checks against bias's and out's: its meta's checks are guards,
+        # so a call eager rejects raises eager's error and never replays
+        def fn(a, b, out):
+            bias = out + 1
+            torch.addmm(bias, a, b, out=out)
+            return bias
+
+        def call(m, m_out):
+            return [_randn(*s, dtype=torch.bfloat16) for s in ((12, 0), (0, m), (12, m_out))]
+
+        entry = HostTraceReplay(fn)
+        for m in (128, 128, 64):
+            args = call(m, m)
+            want = [a.clone() for a in args]
+            self.assertEqual(entry(*args), fn(*want), atol=0, rtol=0)
+            self.assertEqual(args[2], want[2], atol=0, rtol=0)
+        self.assertEqual((entry.traces, entry.replays, entry.eager), (1, 2, 0))
+        args = call(64, 65)
+        with self.assertRaisesRegex(RuntimeError, "must match the existing size"):
+            fn(*[a.clone() for a in args])
+        with self.assertRaisesRegex(RuntimeError, "must match the existing size"):
+            entry(*args)
+        self.assertEqual(entry.replays, 2)
+
+    def test_a_shape_routed_op_resizing_out_is_eager(self):
+        # addmm.out at K = 0 into a padded out whose n is not mat2's: eager resizes out to (m, n)
+        # contiguous on its storage; the meta's resize check is a guard, and the trace at that
+        # call declines visibly (its warm-up resized out), so nothing writes the old layout or the padding
+        def fn(out, a, b):
+            torch.addmm(out.new_ones(()), a, b, out=out)
+
+        entry = HostTraceReplay(fn)
+        for n, ld in ((128, 131), (129, 132)):
+            base = torch.randn(127 * ld, device="cuda")
+            ref = base.clone()
+            a, b = torch.randn(127, 0, device="cuda"), torch.randn(0, 128, device="cuda")
+            out, want = base.as_strided((127, n), (ld, 1)), ref.as_strided((127, n), (ld, 1))
+            entry(out, a, b)
+            fn(want, a, b)
+            self.assertEqual((out.shape, out.stride()), (want.shape, want.stride()))
+            self.assertEqual(base, ref, atol=0, rtol=0)
+        self.assertEqual((entry.traces, entry.replays, entry.eager), (2, 0, 1))
+        self.assertIn("the warm-up changed the metadata of arg0", " ".join(entry.declines))
