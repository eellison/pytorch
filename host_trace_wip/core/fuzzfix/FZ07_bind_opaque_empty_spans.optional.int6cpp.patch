+    def test_a_respecified_bound_tape_keeps_its_allocations_in_op_order(self):
+        # bind_opaque (oob_learn's) gave the ops of no allocation (add.out, copy_) an empty span past
+        # every allocation: respec's _splice, which reads the spans in op order, kept each allocation
+        # twice and gave the GEMMs' outputs seqs past their launches, and the eager-order plan put
+        # live buffers on each other (every element wrong)
+        def fn(a, b):
+            torch.add(b, 1, out=b)
+            v0 = a @ a.t()
+            v1 = v0 @ a
+            v2 = v1.t() @ a
+            v4 = v1 @ v2
+            v1.copy_(a)
+            return v4 @ (v2.t() @ b)
+
+        def randn(*size):
+            return torch.randn(size, device="cuda", dtype=torch.float16) * 0.1
+
+        f = HostTraceReplay(fn)
+        for a, b in ((randn(128, 30), randn(30, 64)), (randn(43, 96).t(), randn(43, 27)), (randn(43, 96).t(), randn(43, 27))):
+            self.assertEqual(f(a, b.clone()), fn(a, b.clone()), atol=0, rtol=0)
+        self.assertEqual((f.traces, f.respecs, f.respec_refusals, f.replays, f.eager), (1, 1, {}, 2, 0))
+        for v in f.variants:
+            spans = [op.allocs for op in v.tape.ops]
+            self.assertEqual([r.start for r in spans], [0, *(r.stop for r in spans[:-1])])
+            self.assertEqual(spans[-1].stop, len(v.tape.allocs))
+            firsts = [(op.allocs, v.tape.launches[op.launches.start][0]) for op in v.tape.ops if op.launches]
+            self.assertTrue(all(v.tape.allocs[j].seq < seq for span, seq in firsts for j in span))
+
