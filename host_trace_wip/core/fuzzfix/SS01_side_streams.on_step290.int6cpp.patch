+def _shared_side(x, w):
+    side, cur = _side("shared"), torch.cuda.current_stream()
+    side.wait_stream(cur)
+    with torch.cuda.stream(side):
+        s = x @ w
+    y = torch.relu(x @ w)
+    cur.wait_stream(side)
+    return y + s
