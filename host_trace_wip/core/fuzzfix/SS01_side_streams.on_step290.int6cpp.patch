+class _Fork:
+    """A run's launches on their streams in its capture (StreamOrder): each on
+    its logical stream after an event of each launch of the run it follows,
+    a side stream's first with none after the run's start; the origin joins
+    every side stream at the end. Event records and waits add no nodes."""
+
+    def __init__(self, order: StreamOrder, run: range, handles: Sequence[int]) -> None:
+        self.stream = [order.stream[j] for j in run]
+        self.after = [tuple(p - run.start for p in order.after[j] if p >= run.start) for j in run]
+        self.priority = [order.priorities[k] for k in self.stream]
+        self.handles = handles
+        self.waited = {p for a in self.after for p in a}
+        self.events: dict[int, Any] = {}  # by launch, -1 the run's start
+        self.forked: set[int] = set()
+
+    def _record(self, i: int, stream: int) -> None:
+        from cuda.bindings import runtime
+
+        self.events[i] = _check_cuda_bindings(runtime.cudaEventCreateWithFlags(runtime.cudaEventDisableTiming))
+        _check_cuda_bindings(runtime.cudaEventRecord(self.events[i], stream))
+
+    def _wait(self, stream: int, i: int) -> None:
+        from cuda.bindings import runtime
+
+        _check_cuda_bindings(runtime.cudaStreamWaitEvent(stream, self.events[i], 0))
+
+    def begin(self) -> None:
+        self._record(-1, self.handles[0])
+
+    def before(self, i: int) -> int:
+        """Launch i's stream, ordered after what it follows."""
+        k = self.stream[i]
+        handle = self.handles[k]
+        if k and k not in self.forked and not self.after[i]:
+            self._wait(handle, -1)
+        self.forked.add(k)
+        for p in self.after[i]:
+            self._wait(handle, p)
+        return handle
+
+    def done(self, i: int) -> None:
+        if i in self.waited:
+            self._record(i, self.handles[self.stream[i]])
+
+    def join(self) -> None:
+        for k in sorted(self.forked - {0}):
+            self._record(-2 - k, self.handles[k])
+            self._wait(self.handles[0], -2 - k)
+
+    def close(self) -> None:
+        from cuda.bindings import runtime
+
+        for event in self.events.values():
+            _check_cuda_bindings(runtime.cudaEventDestroy(event))
+
