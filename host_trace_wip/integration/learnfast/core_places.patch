+def _section_places_scan(lowered, plan, nodes):
+    # section_places as a scan of the run's events (the uncached form): the reference the cached bisect must equal
+    from torch.cuda._host_trace_memory import _first_seqs
+
+    step = next(i for i, s in enumerate(lowered.steps) if isinstance(s, range) and nodes[0] in s)
+    m, first, last = plan.steps[step], lowered.span(nodes[0])[0], lowered.span(nodes[-1])[1]
+    seqs = _first_seqs(lowered)
+    if not m.order:
+        at = sum(seqs[k] < first for k in m.tensors)
+        return at, at
+    n = len(lowered.allocations)
+    ends = {-1 - k: end for k, _, end in m.temporaries} | {-1 - n - a: seq for a, seq in m.freed}
+    keys = [(seqs[e], 0) if e >= 0 else (ends[e], 1) for e in m.order]
+    return sum(k < (first, 0) for k in keys), sum(k < (last, 2) for k in keys)
+
+
+@unittest.skipIf(not TEST_CUDA, "requires CUDA")
+class TestSectionPlaces(TestCase):
+    @parametrize("memory", ["eager", "run_buffer"])
+    def test_cached_places_equal_the_scan(self, memory):
+        # every selector of a replay whose variant took sum's split-reduction section: the cached, bisected places
+        # equal the scan's, and a plan copied with other steps (dataclasses.replace shares the cache) recomputes
+        import dataclasses
+
+        from torch.cuda._host_trace_memory import section_places
+
+        def f(x):
+            return (x * 2).sum(0) + 1
+
+        r = HostTraceReplay(f, memory=memory)
+        for t in (100, 300, 5000, 6000, 100, 5000):
+            x = torch.randn(t, 64, device="cuda")
+            self.assertEqual(r(x), f(x), atol=0, rtol=0)
+        self.assertEqual(r.sections, 1)
+        (v,) = r.variants
+        lowered, plan = v.captured.lowered, v.memory
+        checked = 0
+        for sel in lowered.selectors:
+            if sel.nodes:
+                for _ in range(2):  # the second call reads the cache
+                    self.assertEqual(section_places(lowered, plan, sel.nodes), _section_places_scan(lowered, plan, sel.nodes))
+                checked += 1
+        self.assertGreater(checked, 0)
+        steps = [dataclasses.replace(m, temporaries=tuple((k, seq, seq) for k, seq, _ in m.temporaries)) for m in plan.steps]
+        other = dataclasses.replace(plan, steps=tuple(steps))
+        for sel in lowered.selectors:
+            if sel.nodes:
+                self.assertEqual(section_places(lowered, other, sel.nodes), _section_places_scan(lowered, other, sel.nodes))
+
+
+instantiate_parametrized_tests(TestSectionPlaces)
+
