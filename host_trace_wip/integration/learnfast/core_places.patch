+def _event_keys(lowered: LoweredTape, plan: MemoryPlan, step: int) -> tuple[bool, list]:
+    """The run of `step`'s events as section_places counts them, sorted (a count of those below a key is a bisect):
+    in eager order each event's (seq, 0) for a make, (its free's seq, 1) for a free; in a run of no order its
+    tensors' seqs. Cached on the plan (MemoryPlan.event_keys): every section entry of the run asks."""
+    m = plan.steps[step]
+    got = plan.event_keys.get(step)
+    if got is None or got[0] is not m or got[1] is not lowered:
+        seqs = _first_seqs(lowered)
+        if not m.order:
+            got = (m, lowered, False, sorted(seqs[k] for k in m.tensors))
+        else:
+            n = len(lowered.allocations)
+            ends = {-1 - k: end for k, _, end in m.temporaries} | {-1 - n - a: seq for a, seq in m.freed}
+            got = (m, lowered, True, sorted((seqs[e], 0) if e >= 0 else (ends[e], 1) for e in m.order))
+        plan.event_keys[step] = got
+    return got[2], got[3]
 
 
