+class TestRootIndex(TestCase):
+    def test_the_root_index_agrees_with_a_scan(self):
+        # _roots_of's index (extended as a trace's records grow, rebuilt where they are cut back) against a scan of
+        # every root, on a trace of many allocations: the same roots in the same order for each root's base and an
+        # address into it; then on a copy of the records cut back and grown again
+        import torch.cuda._host_trace_cute as cute
+        from torch.cuda._host_trace_tape import current_trace
+
+        class Records:
+            def __init__(self, tr):
+                self.inputs, self.allocs, self.eager_outputs = list(tr.inputs), list(tr.allocs), list(tr.eager_outputs)
+
+        def scan(t, v):
+            key = cute._sym_key(v)
+            held = set() if isinstance(key, int) else key.free_symbols
+            roots = (*(i.root for i in t.inputs), *(a.root for a in t.allocs), *(o._root for o in t.eager_outputs))
+            return [r.name for r in roots if cute._sym_key(r.sym).free_symbols & held]
+
+        checked = []
+
+        def fn(x):
+            ys = [x + i for i in range(64)]
+            tr = current_trace()
+            copy = Records(tr)
+
+            def check(t):
+                for y in (x, *ys):
+                    for v in (y._root.sym, y._root.sym + 16):
+                        self.assertEqual([r.name for r in cute._roots_of(t, v)], scan(t, v))
+                        checked.append(v)
+
+            check(tr)
+            check(copy)
+            n = len(copy.allocs)
+            del copy.allocs[n // 2 :]
+            check(copy)
+            copy.allocs.extend(tr.allocs[n // 2 :])
+            check(copy)
+            copy.allocs[n - 1] = tr.allocs[0]
+            check(copy)
+            return ys[-1]
+
+        trace(fn, (torch.randn(8, device="cuda"),), warm_up=False)
+        self.assertGreaterEqual(len(checked), 5 * 2 * 65)
+
+
 instantiate_parametrized_tests(TestHostTraceCute)
 
