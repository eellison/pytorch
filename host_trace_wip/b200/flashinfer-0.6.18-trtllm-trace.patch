+# The real trtllm-gen launcher's kernel nodes, captured on stand-in tensors,
+# and a byte-for-byte cross-check of recorded launches against them. The
+# launcher (csrc/trtllm_fmha_kernel_launcher.cu, fmhaKernels.cuh run()) passes
+# one __grid_constant__ KernelParams (kernelParams.h, 1344 bytes); a recorded
+# launch splits it into PIECES. TmaDescriptor.encode ORs _DSL_ENCODE_BIT into
+# byte 8 of each descriptor it encodes; compare ORs it into the witness's
+# non-zero descriptors too.
+from __future__ import annotations
+
+import contextlib
+import dataclasses
+import json
+import os
+import struct
+from typing import Any, Callable, Iterator, Sequence
+
+import torch
+from torch.cuda._host_trace_capture import capture_kernel_nodes, explicit_attributes, KernelNode, pack_params
+from torch.cuda._host_trace_launch import _DSL_ENCODE_BIT, KernelLaunch
+
+PARAMS_SIZE = 1344
+# (name, lo, hi, descriptor)
+PIECES = (
+    ("tmaQ", 0, 128, True),
+    ("tmaK", 128, 256, True),
+    ("tmaKSlidingWindowKvPool", 256, 384, True),
+    ("tmaV", 384, 512, True),
+    ("tmaO", 512, 640, True),
+    ("tmaKSf", 640, 768, True),
+    ("tmaVSf", 768, 896, True),
+    ("fields", 896, PARAMS_SIZE, False),
+)
+
+_PTRS = (
+    "ptrO ptrSfO ptrAttentionSinks ptrCumSeqLensQ ptrCumSeqLensKv ptrCustomMask ptrCustomMaskOffsets ptrDebugO "
+    "ptrDsv4InvRopeCosSinCache ptrDsv4OScaleFp32 ptrFirstSparseMaskOffsetsKv ptrMultiCtasKvCounter ptrOutputScale "
+    "ptrPageIdxKv ptrPartialO ptrPartialStats ptrSageAttnSfsK ptrSageAttnSfsP ptrSageAttnSfsQ ptrSageAttnSfsV "
+    "ptrScaleSoftmaxLog2 ptrScaleSfKv ptrScaleSfO ptrSeqLensKv ptrSkipSoftmaxStats ptrSoftmaxStats ptrSparseMlaTopKLens"
+).split()
+# KernelParams after the 7 descriptors, in declaration order: (name, struct format, alignment).
+# mNumHeadsQPerKvDivisor is cuda::fast_mod_div<int32_t> (data/cccl .../fast_modulo_division.h):
+# int32 divisor, uint32 multiplier, unsigned add, int shift.
+_DECL = (
+    [(n, "i", 4) for n in ("logicalGridDimX", "logicalGridDimY", "logicalGridDimZ")]
+    + [(n, "Q", 8) for n in _PTRS]
+    + [("mAttentionWindowSize", "i", 4), ("mBatchSize", "i", 4), ("mChunkedAttentionSizeLog2", "i", 4)]
+    + [("mDsv4ScaleBufM", "q", 8), ("mInflateMax", "f", 4)]
+    + [(f"mLogNumEltsPerSageAttnBlk{c}", "i", 4) for c in "KPQV"]
+    + [(n, "i", 4) for n in ("mMaxSeqLenQ", "mMaxSeqLenKv", "mMaxNumCtasQ", "mMaxNumCtasKv", "mMaxNumPagesPerSeqKv")]
+    + [(n, "i", 4) for n in ("mNumHeadsKv", "mNumHeadsQ", "mNumHeadsQPerKv")]
+    + [("mNumHeadsQPerKvDivisor", "16s", 4), ("mNumHiddenEltsO", "q", 8)]
+    + [(n, "i", 4) for n in ("mNumPagesInMemPool", "mNumTokensPerCtaQ", "mNumTokensPerPageLog2", "mReshapeFactorKv")]
+    + [(n, "f", 4) for n in ("mOutputScale", "mScaleSoftmaxLog2", "mScaleSfKv", "mScaleSfO", "mSkipSoftmaxThresholdScaleFactor")]
+    + [(n, "i", 4) for n in ("mSparseAttnTopK", "mStartTokenIdxSfO", "mSumOfSeqLensQ", "mSumOfSeqLensKv")]
+    + [("mUseBlockSparseAttention", "?", 1), ("mUsesSharedPagedKvIdx", "?", 1)]
+)
+
+
+def _layout() -> tuple[tuple[str, int, str], ...]:
+    out, at = [], 896
+    for name, fmt, align in _DECL:
+        at += -at % align
+        out.append((name, at, fmt))
+        at += struct.calcsize(fmt)
+    if at + -at % 64 != PARAMS_SIZE:
+        raise AssertionError(f"KernelParams layout ends at {at}")
+    return tuple(out)
+
+
+# (name, byte offset in KernelParams, struct format)
+FIELDS = _layout()
+
+
+def field_at(offset: int) -> str:
+    """The piece or KernelParams field holding the byte at `offset`."""
+    for name, at, fmt in FIELDS:
+        if at <= offset < at + struct.calcsize(fmt):
+            return name
+    for name, lo, hi, _ in PIECES[:-1]:
+        if lo <= offset < hi:
+            return name
+    return "padding"
+
+
+def decode_fields(params: bytes) -> dict[str, Any]:
+    """KernelParams' scalar fields; the divisor as (divisor, multiplier, add, shift)."""
+    out: dict[str, Any] = {}
+    for name, at, fmt in FIELDS:
+        (v,) = struct.unpack_from("<" + fmt, params, at)
+        out[name] = struct.unpack("<iIIi", v) if fmt == "16s" else v
+    return out
+
+
+def with_encode_bit(params: bytes) -> bytes:
+    """KernelParams with _DSL_ENCODE_BIT ORed into byte 8 of each non-zero
+    descriptor, as TmaDescriptor.encode leaves it."""
+    out = bytearray(params)
+    for _, lo, hi, descriptor in PIECES:
+        if descriptor and any(out[lo:hi]):
+            out[lo + 8] |= _DSL_ENCODE_BIT
+    return bytes(out)
+
+
+def _attr_name(key: Any) -> str:
+    return key.name.removeprefix("CU_LAUNCH_ATTRIBUTE_")
+
+
+@dataclasses.dataclass(frozen=True)
+class WitnessNode:
+    """A kernel node of the real launcher's capture."""
+
+    name: str
+    function: int  # the CUfunction (0 for a node loaded from the corpus)
+    layout: tuple[tuple[int, int], ...]
+    grid: tuple[int, int, int]
+    block: tuple[int, int, int]
+    smem: int
+    cluster: tuple[int, int, int]
+    # the attributes a launch sets to reproduce the node (explicit_attributes),
+    # by name; PROGRAMMATIC_STREAM_SERIALIZATION apart as `programmatic`
+    attributes: dict[str, Any]
+    programmatic: bool
+    params: bytes  # every parameter's bytes, at their layout offsets
+    # every attribute the driver reports for the node, by name (not compared)
+    reported: dict[str, Any] = dataclasses.field(default_factory=dict, compare=False)
+
+    @staticmethod
+    def of(node: KernelNode) -> WitnessNode:
+        end = max((o + n for o, n in node.layout), default=0)
+        params = bytearray(end)
+        for (o, n), image in zip(node.layout, node.images):
+            params[o : o + n] = image
+        attributes = {_attr_name(k): v for k, v in explicit_attributes(node)}
+        cluster = tuple(attributes.get("CLUSTER_DIMENSION", (1, 1, 1)))
+        programmatic = bool(node.attribute("PROGRAMMATIC_STREAM_SERIALIZATION"))
+        return WitnessNode(node.name, node.function, node.layout, node.grid, node.block, node.smem,
+                           cluster, attributes, programmatic, bytes(params),  # type: ignore[arg-type]
+                           {_attr_name(k): v for k, v in node.attributes})
+
+    @property
+    def is_fmha(self) -> bool:
+        return self.layout == ((0, PARAMS_SIZE),)
+
+    def fields(self) -> dict[str, Any]:
+        return decode_fields(self.params) if self.is_fmha else {}
+
+    def to_json(self) -> dict[str, Any]:
+        d = dataclasses.asdict(self)
+        d["params"] = self.params.hex()
+        for key in ("attributes", "reported"):
+            d[key] = {k: list(v) if isinstance(v, tuple) else (v.hex() if isinstance(v, bytes) else int(v))
+                      for k, v in getattr(self, key).items()}
+        if self.is_fmha:
+            d["decoded"] = {k: list(v) if isinstance(v, tuple) else v for k, v in self.fields().items()}
+        return d
+
+    @staticmethod
+    def from_json(d: dict[str, Any]) -> WitnessNode:
+        attributes = {k: tuple(v) if isinstance(v, list) else v for k, v in d["attributes"].items()}
+        return WitnessNode(d["name"], 0, tuple(map(tuple, d["layout"])), tuple(d["grid"]), tuple(d["block"]),
+                           d["smem"], tuple(d["cluster"]), attributes, d["programmatic"], bytes.fromhex(d["params"]),
+                           d.get("reported", {}))
+
+
+def _stand_in_arg(a: Any) -> Any:
+    from torch.cuda._host_trace_tape import _hint, _TracedTensor
+
+    if isinstance(a, _TracedTensor):
+        from torch.cuda._host_trace_cute import _stand_in
+
+        return _stand_in(a)
+    if isinstance(a, (list, tuple)):
+        return type(a)(_stand_in_arg(x) for x in a)
+    if isinstance(a, torch.SymInt):
+        return _hint(a)
+    return a
+
+
+def witness(binding: Callable[..., Any], args: Sequence[Any]) -> list[WitnessNode]:
+    """The kernel nodes of binding(*args) captured on a side stream and never
+    replayed; a traced tensor argument as its stand-in at its hints. A fill
+    kernel is captured first and dropped, so the edge into the binding's first
+    node is there to say whether its launch allows programmatic serialization.
+    Loading a module under capture is not allowed: the binding must have run
+    eagerly once on kernels these shapes select."""
+    from torch.utils._python_dispatch import _disable_current_modes
+
+    stand_ins = [_stand_in_arg(a) for a in args]
+    with _disable_current_modes():
+        anchor = torch.empty(1, device=torch.cuda.current_device())
+
+    def run(_: torch.cuda.Stream) -> None:
+        with _disable_current_modes():
+            anchor.fill_(0)
+            binding(*stand_ins)
+
+    fill, *nodes = capture_kernel_nodes(run)
+    if any(not isinstance(n, KernelNode) for n in (fill, *nodes)):
+        raise ValueError(f"the binding added a non-kernel node: {nodes}")
+    # a decode whose kernel has no cubin prints CUDA_ERROR_NOT_FOUND and launches nothing
+    if not any(n.layout == ((0, PARAMS_SIZE),) for n in nodes):  # type: ignore[union-attr]
+        raise ValueError(f"the binding launched no fmha kernel: {[n.name for n in nodes]}")  # type: ignore[union-attr]
+    return [WitnessNode.of(n) for n in nodes]  # type: ignore[arg-type]
+
+
+@dataclasses.dataclass
+class BindingCall:
+    kind: str  # "decode" or "context"
+    binding: Callable[..., Any]
+    args: tuple[Any, ...]
+
+
+@contextlib.contextmanager
+def record_binding_calls() -> Iterator[list[BindingCall]]:
+    """Each trtllm_paged_attention_{decode,context} call the public
+    flashinfer.decode / flashinfer.prefill APIs make inside the block, run
+    through and kept with its arguments."""
+    import flashinfer.decode as dec
+    import flashinfer.prefill as pre
+
+    calls: list[BindingCall] = []
+
+    class Proxy:
+        def __init__(self, op: Any) -> None:
+            self._op = op
+
+        def __getattr__(self, name: str) -> Any:
+            fn = getattr(self._op, name)
+            kind = {"trtllm_paged_attention_decode": "decode", "trtllm_paged_attention_context": "context"}.get(name)
+            if kind is None:
+                return fn
+
+            def call(*args: Any) -> Any:
+                calls.append(BindingCall(kind, fn, args))
+                return fn(*args)
+
+            return call
+
+    saved = (dec.get_trtllm_gen_fmha_module, pre.get_trtllm_gen_fmha_module)
+    dec.get_trtllm_gen_fmha_module = lambda: Proxy(saved[0]())
+    pre.get_trtllm_gen_fmha_module = lambda: Proxy(saved[1]())
+    try:
+        yield calls
+    finally:
+        dec.get_trtllm_gen_fmha_module, pre.get_trtllm_gen_fmha_module = saved
+
+
+@dataclasses.dataclass(frozen=True)
+class Launch:
+    """A recorded launch at concrete values, as compare reads it."""
+
+    name: str
+    grid: tuple[int, int, int]
+    block: tuple[int, int, int]
+    smem: int
+    cluster: tuple[int, int, int]
+    attributes: dict[str, Any]
+    programmatic: bool
+    params: bytes
+
+
+def as_launch(r: Any, strict: bool = True) -> Launch:
+    """A KernelLaunch (its slots at their hints, packed as a replay packs
+    them), a WitnessNode, a Launch, or a dict with Launch's keys (params as
+    bytes or hex). `strict` packs a KernelLaunch over zeros, not its
+    `images`: a byte no field or descriptor writes then shows as a diff
+    wherever the real launcher's is not zero (images taken from a capture
+    at the hints hide them)."""
+    if isinstance(r, Launch):
+        return r
+    if isinstance(r, WitnessNode):
+        params = with_encode_bit(r.params) if r.is_fmha else r.params
+        return Launch(r.name, r.grid, r.block, r.smem, r.cluster, r.attributes, r.programmatic, params)
+    if isinstance(r, dict):
+        p = r["params"]
+        return Launch(r.get("name", "?"), tuple(r["grid"]), tuple(r["block"]), r["smem"],
+                      tuple(r.get("cluster", (1, 1, 1))), dict(r.get("attributes", {})),
+                      bool(r.get("programmatic", False)), bytes.fromhex(p) if isinstance(p, str) else bytes(p))
+    if isinstance(r, KernelLaunch):
+        from torch.cuda._host_trace_tape import _hint, _PLACEHOLDER_LOW
+
+        if r.pointers is None:
+            raise ValueError(f"launch {r.name} has no pointer slots (a Triton launch?)")
+        pointers = [i in r.pointers for i in range(len(r.slots))]
+        slots = [_hint(v) & _PLACEHOLDER_LOW if p else _hint(v) for v, p in zip(r.slots, pointers)]
+        packed = pack_params(dataclasses.replace(r, images=()) if strict else r, slots, pointers)
+        end = max(o + n for o, n in r.layout)
+        params = bytearray(end)
+        for (o, n), image in zip(r.layout, packed):
+            params[o : o + n] = image
+        attributes = {_attr_name(k): v for k, v in r.attributes}
+        return Launch(r.name, tuple(map(_hint, r.grid)), tuple(map(_hint, r.block)), _hint(r.smem),
+                      r.cluster, attributes, r.programmatic, bytes(params))
+    raise TypeError(f"not a launch: {type(r).__name__}")
+
+
+def _pieces(w: WitnessNode) -> list[tuple[str, int, int, bool]]:
+    if w.is_fmha:
+        return list(PIECES)
+    return [(f"p{i}", o, o + n, False) for i, (o, n) in enumerate(w.layout)]
+
+
+def compare(witness_nodes: Sequence[WitnessNode], recorded_launches: Sequence[Any], strict: bool = True) -> list[dict[str, Any]]:
+    """Per witness node and recorded launch, in order: the launch config
+    mismatches ("config": {what: (witness, recorded)}) and per piece the
+    differing bytes ("pieces": {piece: [(offset, field, witness, recorded)]}),
+    offsets into the whole parameter buffer. A node count mismatch is an
+    entry with "count". Everything empty means bitwise equal. `strict` as
+    as_launch's. A KernelNode is taken as its WitnessNode."""
+    witness_nodes = [WitnessNode.of(w) if isinstance(w, KernelNode) else w for w in witness_nodes]
+    out: list[dict[str, Any]] = []
+    if len(witness_nodes) != len(recorded_launches):
+        out.append({"count": (len(witness_nodes), len(recorded_launches)),
+                    "names": ([w.name for w in witness_nodes], [as_launch(r, strict).name for r in recorded_launches])})
+    for w, r in zip(witness_nodes, recorded_launches):
+        r = as_launch(r, strict)
+        config = {}
+        for what in ("name", "grid", "block", "smem", "cluster", "programmatic", "attributes"):
+            a, b = getattr(w, what), getattr(r, what)
+            if what == "attributes":
+                a, b = {k: v for k, v in a.items()}, {k: v for k, v in b.items()}
+            if a != b:
+                config[what] = (a, b)
+        theirs = r.params
+        mine = with_encode_bit(w.params) if w.is_fmha else w.params
+        pieces: dict[str, list[tuple[int, str, int, int]]] = {}
+        if len(theirs) != len(mine):
+            config["params_size"] = (len(mine), len(theirs))
+        for name, lo, hi, _ in _pieces(w):
+            diffs = [(i, field_at(i) if w.is_fmha else name, mine[i], theirs[i])
+                     for i in range(lo, min(hi, len(theirs))) if mine[i] != theirs[i]]
+            if diffs:
+                pieces[name] = diffs
+        out.append({"node": w.name, "config": config, "pieces": pieces})
+    return out
+
+
+def equal(report: list[dict[str, Any]]) -> bool:
+    return all("count" not in e and not e["config"] and not e["pieces"] for e in report)
+
+
+def summarize(report: list[dict[str, Any]]) -> str:
+    """One line per mismatch: config entries, then per field the byte range."""
+    lines = []
+    for e in report:
+        if "count" in e:
+            lines.append(f"node count witness {e['count'][0]} recorded {e['count'][1]}: {e['names']}")
+            continue
+        for what, (a, b) in e["config"].items():
+            lines.append(f"{e['node'][:60]}: {what} witness {a} recorded {b}")
+        for piece, diffs in e["pieces"].items():
+            by_field: dict[str, list[int]] = {}
+            for i, f, _, _ in diffs:
+                by_field.setdefault(f, []).append(i)
+            for f, offs in by_field.items():
+                lines.append(f"{e['node'][:60]}: {piece}/{f} bytes {offs[0]}..{offs[-1]} ({len(offs)} differ)")
+    return "\n".join(lines)
+
+
+def save_corpus(path: str, config: dict[str, Any], args_desc: dict[str, Any], nodes: Sequence[WitnessNode]) -> None:
+    """One config's witness: the API call's config, the binding's argument
+    summary (each tensor's shape, strides, dtype and data_ptr) and the nodes."""
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    with open(path, "w") as f:
+        json.dump({"config": config, "binding_args": args_desc, "nodes": [n.to_json() for n in nodes]}, f, indent=1)
+
+
+def load_corpus(path: str) -> tuple[dict[str, Any], dict[str, Any], list[WitnessNode]]:
+    with open(path) as f:
+        d = json.load(f)
+    return d["config"], d["binding_args"], [WitnessNode.from_json(n) for n in d["nodes"]]
+
+
+def describe_args(args: Sequence[Any]) -> list[Any]:
+    """A JSON summary of binding arguments: each tensor as its shape,
+    strides, dtype and address, other values as themselves (repr if not JSON)."""
+    out: list[Any] = []
+    for a in args:
+        if isinstance(a, torch.Tensor):
+            out.append({"shape": list(a.shape), "stride": list(a.stride()), "dtype": str(a.dtype),
+                        "data_ptr": a.data_ptr(), "storage_offset": a.storage_offset()})
+        elif a is None or isinstance(a, (bool, int, float, str)):
+            out.append(a)
+        elif isinstance(a, (list, tuple)):
+            out.append(describe_args(a))
+        else:
+            out.append(repr(a))
+    return out
