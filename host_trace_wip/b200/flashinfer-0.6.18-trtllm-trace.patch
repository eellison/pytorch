diff -ruN -x __pycache__ a/flashinfer/trtllm_trace.py b/flashinfer/trtllm_trace.py
--- a/flashinfer/trtllm_trace.py	1969-12-31 16:00:00.000000000 -0800
+++ b/flashinfer/trtllm_trace.py	2026-10-08 18:57:53.952073906 -0700
@@ -0,0 +1,1245 @@
+# trtllm-gen paged attention under CUDA graph host tracing: the host logic of
+# csrc/trtllm_fmha_kernel_launcher.cu and include/flashinfer/trtllm/fmha
+# (fmhaKernels.cuh selection and CTA config, kernelParams.h setKernelParams,
+# lse.cuh) ported to Python over the trace's symbolic values. Under a trace the
+# two bindings run as flashinfer_ht custom ops whose CUDA kernel records the
+# fmha launch (and the LSE launch) as KernelLaunches: every field an expression,
+# every branch on a symbolic value a guard. Each recorded call is checked byte
+# for byte against the real launcher's kernel nodes, captured on a side stream
+# at the hints. Outside a trace the bindings run unchanged.
+from __future__ import annotations
+
+import contextlib
+import ctypes
+import dataclasses
+import functools
+import math
+import os
+import re
+import struct
+from typing import Any, Optional
+
+import torch
+
+INT_MAX = 2**31 - 1
+
+# Data_type
+FP16, BF16, FP32, INT8, INT32, E4M3, E5M2, E2M1 = range(8)
+_BITS = {FP16: 16, BF16: 16, FP32: 32, INT8: 8, INT32: 32, E4M3: 8, E5M2: 8, E2M1: 4}
+_DTYPES = {torch.float16: FP16, torch.bfloat16: BF16, torch.float32: FP32, torch.float8_e4m3fn: E4M3, torch.float8_e5m2: E5M2, torch.uint8: E2M1}
+# kSM_*
+SM_100, SM_103, SM_107, SM_100F = 100, 103, 107, 10100
+# QkvLayout, mask, kernel type, tile scheduler, multi-CTA KV mode
+PAGED_KV = 2
+DENSE, CAUSAL, SLIDING_OR_CHUNKED = 0, 1, 2
+CONTEXT, GENERATION, SWAPS_AB, KEEPS_AB = 0, 1, 2, 3
+STATIC, PERSISTENT = 0, 1
+MCKV_DISABLED, MCKV_GMEM, MCKV_GMEM_SEPARATE, MCKV_CGA = 0, 1, 2, 3
+# Bf16QFp8KvTransformMode
+TRANSFORM_FULL, TRANSFORM_K_ONLY, TRANSFORM_SEPARATE_KV = 0, 1, 2
+_STATIC_SMEM_RESERVE = 1024
+_DYNAMIC_PAGE_KEY = 128
+
+
+@dataclasses.dataclass(frozen=True)
+class Meta:
+    """A TllmGenFmhaKernelMetaInfo entry."""
+
+    dtype_q: int
+    dtype_kv: int
+    dtype_k: int
+    dtype_v: int
+    dtype_o: int
+    tile_q: int
+    tile_kv: int
+    step_q: int
+    step_kv: int
+    hd_per_cta_v: int
+    hd_qk: int
+    hd_v: int
+    sm: int
+    name: str
+    smem: int
+    threads: int
+    layout: int
+    page: int
+    mask: int
+    kernel_type: int
+    scheduler: int
+    multi: int
+    sage: tuple[int, int, int, int]
+    groups_heads_q: bool
+    groups_tokens_heads_q: bool
+    reuse_smem_k_for_v: bool
+    two_cta: bool
+    sparse: int
+    skips_softmax: bool
+    fp16_softmax: bool
+    spcompress: bool
+    k_only_transform: bool
+    separate_transformed_kv: bool
+    dsv4_rope: bool
+    dsv4_ue8m0: bool
+    sha256: str
+
+
+_ENTRY = re.compile(r"^\{ (DATA_TYPE_.*)\},?$", re.M)
+_SM_NAMES = {"kSM_100": SM_100, "kSM_103": SM_103, "kSM_107": SM_107, "kSM_100f": SM_100F}
+
+
+def _parse_meta(text: str) -> list[Meta]:
+    dt = {f"DATA_TYPE_{n}": i for i, n in enumerate(("FP16", "BF16", "FP32", "INT8", "INT32", "E4M3", "E5M2", "E2M1", "UNKNOWN"))}
+    metas = []
+    for m in _ENTRY.finditer(text):
+        tok = [t.strip() for t in m.group(1).split(",")]
+        if len(tok) != 41:
+            raise RuntimeError(f"trtllm-gen meta entry of {len(tok)} fields: {m.group(0)[:120]}")
+        b = {"true": True, "false": False}
+        metas.append(
+            Meta(
+                *(dt[t] for t in tok[0:5]),
+                *(int(t) for t in tok[5:12]),
+                _SM_NAMES[tok[12]],
+                tok[15].strip('"'),
+                *(int(t) for t in tok[16:24]),
+                tuple(int(t) for t in tok[24:28]),
+                *(b[t] for t in tok[28:32]),
+                int(tok[32]),
+                *(b[t] for t in tok[33:40]),
+                tok[40].strip('"'),
+            )
+        )
+    return metas
+
+
+def _transform_mode(k_only: bool, separate_kv: bool) -> int:
+    return TRANSFORM_K_ONLY if k_only else TRANSFORM_SEPARATE_KV if separate_kv else TRANSFORM_FULL
+
+
+def _log2(x: int) -> int:
+    return x.bit_length() - 1
+
+
+def hash_id(layout, mask, kernel_type, scheduler, multi, hd_per_cta_v, hd_qk, hd_v, tile_q, tile_kv, page, dynamic_page,
+            reuse_smem_k, two_cta, groups_tokens, sparse, skips, transform, two_q_sliding, fp16_softmax, spcompress) -> int:
+    """TllmGenFmhaKernel::hashID, its checks included."""
+    if not (32 <= hd_per_cta_v <= 1024 and 32 <= hd_qk <= 1024 and 32 <= hd_v <= 1024):
+        raise RuntimeError(f"trtllm-gen: head dims {hd_per_cta_v} {hd_qk} {hd_v}")
+    if page & (page - 1) or tile_q > 128 or tile_kv > 128 or tile_q & (tile_q - 1) or tile_kv not in (64, 128):
+        raise RuntimeError(f"trtllm-gen: page {page}, tiles {tile_q} {tile_kv}")
+    page_log2 = _log2(page) if page else 0
+    if not (0 <= sparse <= 3 and 0 <= transform <= 2 and page_log2 < 16 and layout < 4 and mask < 8 and kernel_type < 8 and scheduler < 4 and multi < 4):
+        raise RuntimeError("trtllm-gen: kernel attribute out of range for the hash key")
+    return (
+        layout | mask << 2 | kernel_type << 5 | scheduler << 8 | multi << 10 | (hd_per_cta_v >> 3) << 12 | (hd_qk >> 3) << 20
+        | (hd_v >> 3) << 28 | (tile_kv >> 6) << 36 | page_log2 << 38 | _log2(tile_q) << 42 | int(reuse_smem_k) << 45
+        | int(two_cta) << 46 | sparse << 47 | int(skips) << 49 | int(dynamic_page) << 50 | transform << 51
+        | int(groups_tokens) << 53 | int(two_q_sliding) << 54 | int(fp16_softmax) << 55 | int(spcompress) << 56
+    )
+
+
+def _meta_hash(m: Meta) -> int:
+    dynamic = m.page == _DYNAMIC_PAGE_KEY and "P128" not in m.name
+    two_q = m.kernel_type == KEEPS_AB and m.groups_tokens_heads_q and m.step_q == 2 * m.tile_q
+    return hash_id(m.layout, m.mask, m.kernel_type, m.scheduler, m.multi, m.hd_per_cta_v, m.hd_qk, m.hd_v, m.tile_q, m.tile_kv,
+                   m.page, dynamic, m.reuse_smem_k_for_v, m.two_cta, m.groups_tokens_heads_q, m.sparse, m.skips_softmax,
+                   _transform_mode(m.k_only_transform, m.separate_transformed_kv), two_q, m.fp16_softmax, m.spcompress)
+
+
+def _sm_compatible(gpu: int, kernel: int) -> bool:
+    if gpu in (SM_100, SM_103, SM_107):
+        return kernel in (SM_100F, gpu)
+    return gpu == kernel
+
+
+def _family_pair(a: int, b: int) -> bool:
+    return (a == SM_100F and b in (SM_100, SM_103, SM_107)) or (b == SM_100F and a in (SM_100, SM_103, SM_107))
+
+
+@functools.cache
+def _meta_text() -> str:
+    from flashinfer.artifacts import ArtifactPath, CheckSumHash
+    from flashinfer.jit.cubin_loader import get_artifact, get_meta_hash
+
+    checksum = get_artifact(f"{ArtifactPath.TRTLLM_GEN_FMHA}/checksums.txt", CheckSumHash.TRTLLM_GEN_FMHA)
+    header = get_artifact(f"{ArtifactPath.TRTLLM_GEN_FMHA}/include/flashInferMetaInfo.h", get_meta_hash(checksum))
+    return header.decode() if isinstance(header, bytes) else header
+
+
+@functools.cache
+def kernel_map(dtype_q: int, dtype_kv: int, dtype_o: int, sm: int, max_smem: int) -> dict[int, Meta]:
+    """TllmGenFmhaKernel::loadKernels' map: hash -> meta, for a device of
+    `sm` (major * 10 + minor) and opt-in smem `max_smem`."""
+    table: dict[int, Meta] = {}
+    for m in _parse_meta(_meta_text()):
+        if m.smem + _STATIC_SMEM_RESERVE > max_smem:
+            continue
+        if not (_sm_compatible(sm, m.sm) and (m.dtype_q, m.dtype_k, m.dtype_v, m.dtype_o) == (dtype_q, dtype_kv, dtype_kv, dtype_o) and m.sage == (0, 0, 0, 0)):
+            continue
+        h = _meta_hash(m)
+        if h in table:
+            if not _family_pair(table[h].sm, m.sm):
+                raise RuntimeError(f"trtllm-gen: hash conflict between {table[h].name} and {m.name}")
+            if table[h].sm == SM_100F:
+                table[h] = m
+        else:
+            table[h] = m
+    return table
+
+
+@dataclasses.dataclass
+class Runner:
+    """The RunnerParams fields kernel selection and setKernelParams read.
+    batch, sum_q, max_q (context), pages_per_seq and pool may be SymInts;
+    the rest are Python values."""
+
+    dtype_q: int
+    dtype_kv: int
+    dtype_o: int
+    kernel_type: int
+    mask: int
+    scheduler: int
+    multi: bool
+    hd_qk: int
+    hd_v: int
+    heads_q: int
+    heads_kv: int
+    page: int
+    max_q: Any
+    max_kv: int
+    batch: Any
+    sum_q: Any
+    pages_per_seq: Any
+    pool: Any
+    window: int
+    sm_count: int
+    skips_softmax: bool
+    fp16_softmax: bool
+    spcompress: bool
+    transform: int
+    # the strides launcher passes, in elements (int32 in the C++)
+    q_stride_tokens: Any = 0
+    q_stride_heads: Any = 0
+    kv_stride_keys: Any = 0
+    kv_stride_heads: Any = 0
+    kv_stride_batch: Any = 0
+    chunked: int = INT_MAX
+
+    @property
+    def heads_q_per_kv(self) -> int:
+        return self.heads_q // self.heads_kv
+
+    @property
+    def bf16q_fp8kv(self) -> bool:
+        return (self.dtype_q, self.dtype_kv, self.dtype_o) == (BF16, E4M3, BF16)
+
+
+@dataclasses.dataclass
+class Select:
+    """SelectKernelParams."""
+
+    kernel_type: int
+    hd_per_cta_v: int
+    multi: int
+    mask: int
+    page: int
+    scheduler: int
+    skips_softmax: bool
+    fp16_softmax: bool
+    spcompress: bool
+    transform: int
+    tile_q: int = 128
+    tile_kv: int = 128
+    dynamic_page: bool = False
+    reuse_smem_k: bool = False
+    two_cta: bool = False
+    groups_tokens: bool = False
+    force_gmem: bool = False
+    select_new: bool = False
+
+    @classmethod
+    def of(cls, p: Runner) -> Select:
+        return cls(p.kernel_type, p.hd_v, MCKV_GMEM if p.multi else MCKV_DISABLED, p.mask, p.page, p.scheduler,
+                   p.skips_softmax, p.fp16_softmax, p.spcompress, p.transform)
+
+
+@dataclasses.dataclass
+class Cta:
+    max_ctas_q: Any
+    max_ctas_kv: Any
+    x: Any
+    y: int
+    z: Any
+    cluster_x: int
+
+
+def _ceil_div(a: Any, b: Any) -> Any:
+    return (a + b - 1) // b
+
+
+def _f32(x: float) -> float:
+    return struct.unpack("<f", struct.pack("<f", x))[0]
+
+
+class Kernels:
+    """TllmGenFmhaKernel for one (dtype Q, KV, O) on the current device:
+    kernel selection and CTA config as fmhaKernels.cuh has them."""
+
+    def __init__(self, p: Runner, sm: int, max_smem: int, force: Optional[tuple[int, int]] = None, table: Optional[dict[int, Meta]] = None,
+                 tile: Optional[int] = None):
+        self.p = p
+        self.map = kernel_map(p.dtype_q, p.dtype_kv, p.dtype_o, sm, max_smem) if table is None else table
+        # (multi-CTA mode, split) of one region of computeCtaAndClusterConfig
+        # whatever the call's sizes, split 0 for the call's: a selected launch's candidate
+        self.force = force
+        # the cost model's tile size whatever the call's sizes (preload's)
+        self.tile = tile
+        self._tiles: dict[tuple, int] = {}
+
+    def meta(self, s: Select) -> Meta:
+        """loadKernel's lookup: the kernel of hashFromRunnerParams."""
+        p = self.p
+        h = hash_id(PAGED_KV, s.mask, s.kernel_type, s.scheduler, s.multi, s.hd_per_cta_v, p.hd_qk, p.hd_v, s.tile_q,
+                    s.tile_kv, s.page, s.dynamic_page, s.reuse_smem_k, s.two_cta, s.groups_tokens, 0, s.skips_softmax,
+                    s.transform, False, s.fp16_softmax, s.spcompress)
+        m = self.map.get(h)
+        if m is None:
+            raise NotFound(
+                f"no trtllm-gen kernel for mask={s.mask} kernelType={s.kernel_type} scheduler={s.scheduler} "
+                f"multiCtasKvMode={s.multi} headDimPerCtaV={s.hd_per_cta_v} headDim={p.hd_qk}/{p.hd_v} tileSizeQ={s.tile_q} "
+                f"tileSizeKv={s.tile_kv} numTokensPerPage={s.page} skipsSoftmax={s.skips_softmax} transform={s.transform}"
+            )
+        return m
+
+    def _select_page(self, s: Select) -> None:
+        p = self.p
+        if p.hd_qk == p.hd_v and p.page >= _DYNAMIC_PAGE_KEY:
+            if p.page & (p.page - 1):
+                raise RuntimeError("trtllm-gen: the page size must be a power of 2")
+            s.dynamic_page, s.page = True, _DYNAMIC_PAGE_KEY
+        else:
+            s.page = p.page
+
+    def _sync_gq(self, s: Select) -> None:
+        p = self.p
+        s.groups_tokens = True
+        enabled = s.multi != MCKV_DISABLED
+        if s.kernel_type == KEEPS_AB and p.hd_v > 256:
+            s.hd_per_cta_v = 256
+            if enabled:
+                s.multi = MCKV_GMEM_SEPARATE
+        else:
+            s.hd_per_cta_v = p.hd_v
+            if enabled and s.multi == MCKV_GMEM_SEPARATE:
+                s.multi = MCKV_GMEM
+
+    def _select_gq(self, s: Select) -> None:
+        p = self.p
+        s.groups_tokens = False
+        if not (p.dtype_q == p.dtype_kv or (p.bf16q_fp8kv and s.transform != TRANSFORM_FULL)):
+            s.tile_q = 8 if p.heads_q_per_kv <= 8 else 16
+            s.kernel_type = SWAPS_AB
+            return
+        s.groups_tokens = True
+        n = p.heads_q_per_kv * p.max_q
+        s.tile_q = 8 if n <= 8 else 16 if n <= 16 else 32 if n <= 32 else 64 if n <= 64 else 128
+        s.kernel_type = SWAPS_AB if s.tile_q <= 32 else KEEPS_AB
+        self._sync_gq(s)
+        if p.max_q > 1:
+            self._select_tile_q(s)
+
+    def _select_tile_q(self, s: Select) -> None:
+        p = self.p
+        if self.tile is not None:
+            best = self.tile
+        elif isinstance(p.max_kv, torch.SymInt) or isinstance(p.batch, torch.SymInt):
+            from torch.cuda._host_trace import choice
+
+            # the cost model's floats read max_kv and the batch: the tile is a
+            # choice guarded on the batch and the run of max_kv that picks it
+            # (_best_tile_q reads max_kv as ceil(max_kv / step) and
+            # ceil(max_kv / (2 step)) over the candidates' KV steps), up to
+            # what the block table addresses
+            if not bool(p.batch == _hint_of(p.batch)):
+                raise RuntimeError("trtllm-gen: the batch is not its hint")
+            at = dataclasses.astuple(s)
+            step = math.gcd(*(m.step_kv for m in self.map.values()))
+            best = choice(p.max_kv, lambda mk: self._best_tile_q(s, mk, at), step, _hint_of(p.pages_per_seq) * p.page)
+        else:
+            best = self._best_tile_q(s, p.max_kv)
+        s.tile_q = best
+        s.kernel_type = KEEPS_AB if best >= 64 else SWAPS_AB
+        self._sync_gq(s)
+
+    def _best_tile_q(self, s: Select, max_kv: Any, at: Optional[tuple] = None) -> int:
+        """selectTileSizeQForGqaGeneration's tileSizeQ at max_kv and the
+        batch, the hints of symbolic ones (memoized per selection pass `at`)."""
+        if at is not None and (at, max_kv) in self._tiles:
+            return self._tiles[at, max_kv]
+        p = dataclasses.replace(self.p, max_kv=_hint_of(max_kv), batch=_hint_of(self.p.batch))
+        k = Kernels(p, 0, 0, self.force, self.map)
+        main = {128: 2.2, 64: 1.68, 32: 1.48, 16: 1.2, 8: 1.0}
+        red = {128: 1.32, 64: 1.2, 32: 1.08, 16: 1.03, 8: 1.0}
+        factor = 2.0 if p.bf16q_fp8kv and s.transform == TRANSFORM_SEPARATE_KV else 1.0
+        c = dataclasses.replace(s)
+        cta = k.cta(k.meta(c), c)
+        best = c.tile_q
+        if cta.x * cta.y * cta.z * 2 <= p.sm_count and c.tile_q > 8:
+            default, best_t = c.tile_q, math.inf
+            for tq in (128, 64, 32, 16, 8):
+                if tq > default or tq < p.heads_q_per_kv:
+                    continue
+                c.tile_q = tq
+                c.kernel_type = KEEPS_AB if tq >= 64 else SWAPS_AB
+                k._sync_gq(c)
+                m = k.meta(c)
+                cta = k.cta(m, c)
+                kv = int(cta.max_ctas_kv)
+                seq = _ceil_div(_ceil_div(p.max_kv, m.step_kv), kv) * m.step_kv
+                t = _f32(_f32(_f32(factor * _f32(main[tq])) * seq) + _f32(_f32(_f32(red[tq]) * 128.0) * kv))
+                t = _f32(t * int(_ceil_div(cta.x * cta.y * cta.z, p.sm_count)))
+                if t < best_t:
+                    best_t, best = t, tq
+        if at is not None:
+            self._tiles[at, max_kv] = best
+        return best
+
+    def select(self, s: Select) -> None:
+        """selectKernel, for paged KV without sparse MLA."""
+        p = self.p
+        self._select_page(s)
+        mla = p.kernel_type != CONTEXT and (p.hd_qk, p.hd_v) in ((576, 512), (320, 256))
+        if mla:
+            raise NotFound("MLA generation")
+        if p.kernel_type in (GENERATION, SWAPS_AB, KEEPS_AB, 4):
+            self._select_gq(s)
+        if p.hd_v > 256 and s.kernel_type != SWAPS_AB:
+            s.hd_per_cta_v = 256
+        if (s.mask == CAUSAL or p.kernel_type != CONTEXT) and (p.max_kv > p.window or p.chunked != INT_MAX):
+            if not (p.max_kv <= p.window or p.max_kv <= p.chunked):
+                raise RuntimeError("Sliding window attention and chunked attention should not be used together")
+            s.mask = SLIDING_OR_CHUNKED
+
+    def cta(self, m: Meta, s: Select) -> Cta:
+        """computeCtaAndClusterConfig."""
+        p = self.p
+        s.select_new = False
+        ctas_q = _ceil_div(p.max_q, m.step_q)
+        if p.kernel_type != CONTEXT and p.max_q > 1:
+            ctas_q = p.max_q if not m.groups_tokens_heads_q else _ceil_div(p.max_q, max(1, m.step_q // p.heads_q_per_kv))
+        per_cta = min(p.heads_q_per_kv, m.step_q) if m.groups_heads_q else 1
+        y0 = p.heads_q // per_cta
+        if per_cta * y0 != p.heads_q or m.hd_v % s.hd_per_cta_v:
+            raise RuntimeError("trtllm-gen: the numHeadsQ/numHeadsKv or headDimPerCtaV is not supported")
+        x, y, z = ctas_q, y0 * (m.hd_v // s.hd_per_cta_v), p.batch
+        n = 1
+        if s.multi != MCKV_DISABLED:
+            attn = p.max_kv
+            if s.mask == SLIDING_OR_CHUNKED:
+                attn = min(p.max_kv, p.window + m.step_kv - 1) if p.max_kv > p.window else min(p.max_kv, p.chunked)
+            most = (attn + 2 * m.step_kv - 1) // (2 * m.step_kv)
+            tuned = most
+            if p.bf16q_fp8kv and s.transform == TRANSFORM_SEPARATE_KV and s.kernel_type == SWAPS_AB and s.multi != MCKV_GMEM_SEPARATE and p.hd_v < 512:
+                cdx = 2 if s.two_cta else 1
+                per_cluster = 16 // cdx
+                if most <= y0 * per_cluster:
+                    launched = _ceil_div(x, cdx) * y * z
+                    budget = max(4, _ceil_div(p.sm_count * 13 // 20, launched))
+                    target = min(most, min(per_cluster, budget))
+                    if 1 < target < most:
+                        tile = _ceil_div(p.window, target - 1) if s.mask == SLIDING_OR_CHUNKED else _ceil_div(attn, target)
+                        if tile <= 1024:
+                            tuned = target
+            n = torch.sym_min(tuned, torch.sym_max(1, p.sm_count // (x * y * z)))
+            if self.force is None:
+                persistent = n <= 1
+                dsv3 = (p.hd_qk, p.hd_v) == (576, 512) and 1 <= p.max_q <= 16 and p.batch == 1
+                cga = not dsv3 and 1 < n <= 16 and s.kernel_type == SWAPS_AB and not s.force_gmem and p.hd_v < 512
+            else:
+                mode, split = self.force
+                n = split or n
+                persistent, cga = mode == MCKV_DISABLED, mode == MCKV_CGA
+            x = x * n
+            if persistent:
+                s.multi, s.scheduler, s.select_new = MCKV_DISABLED, PERSISTENT, True
+            if cga and s.multi == MCKV_GMEM:
+                s.multi, s.select_new = MCKV_CGA, True
+        cx = 2 if s.two_cta else 1
+        if s.multi == MCKV_CGA:
+            # a cluster dimension is a launch attribute: the split count specializes
+            cx *= int(n)
+        return Cta(ctas_q, n, x, y, z, cx)
+
+
+class NotFound(RuntimeError):
+    """The launcher has no kernel for the call: eager raises too."""
+
+
+def plan(k: Kernels) -> tuple[Meta, Select, Cta]:
+    """run()'s selection loop: select, load, CTA config until the config
+    selects no other kernel (at most 4 passes). The Cga occupancy fallback
+    is the launch's (see Launcher.occupancy)."""
+    s = Select.of(k.p)
+    for _ in range(4):
+        k.select(s)
+        m = k.meta(s)
+        cta = k.cta(m, s)
+        if not s.select_new:
+            return m, s, cta
+    raise RuntimeError("trtllm-gen: kernel selection did not converge in 4 passes")
+
+
+# kernel name -> (CUmodule, CUfunction) per device; never unloaded, as the
+# launcher's own TllmGenFmhaKernel
+_FUNCTIONS: dict[tuple[int, str], tuple[Any, Any]] = {}
+
+
+def function(m: Meta, device: int) -> int:
+    """loadKernel's function for m: the cubin the launcher loads (same
+    artifact, same sha256), in a module of ours, its smem set up as
+    setupKernelSmem does."""
+    from cuda.bindings import driver, runtime
+
+    from flashinfer.artifacts import ArtifactPath
+    from flashinfer.jit.cubin_loader import get_artifact
+    from torch.cuda._utils import _check_cuda_bindings
+
+    key = (device, m.name)
+    if key not in _FUNCTIONS and torch.cuda.is_current_stream_capturing():
+        raise NotFound(f"{m.name} was not loaded at the warm-up (a capture holds)")
+    if key not in _FUNCTIONS:
+        # without the cubin the binding launches nothing or raises "Failed to load cubin"
+        try:
+            cubin = get_artifact(f"{ArtifactPath.TRTLLM_GEN_FMHA}/{m.name}.cubin", m.sha256)
+        except Exception as e:
+            raise NotFound(f"no cubin for {m.name}: {e}") from None
+        if not cubin:
+            raise NotFound(f"no cubin for {m.name}")
+        with torch.cuda.device(device):
+            # makes the device's primary context current, as cudart's first call does
+            _check_cuda_bindings(runtime.cudaFree(0))
+            module = _check_cuda_bindings(driver.cuModuleLoadData(cubin))
+            func = _check_cuda_bindings(driver.cuModuleGetFunction(module, m.name.encode()))
+            if m.smem >= 48 * 1024:
+                attr = driver.CUfunction_attribute.CU_FUNC_ATTRIBUTE_MAX_DYNAMIC_SHARED_SIZE_BYTES
+                _check_cuda_bindings(driver.cuFuncSetAttribute(func, attr, m.smem))
+        _FUNCTIONS[key] = (module, func)
+    return int(_FUNCTIONS[key][1])
+
+
+def max_active_clusters(func: int, m: Meta, cta: Cta, block_z: int = 1) -> int:
+    """cuOccupancyMaxActiveClusters at the launch's config, as run() asks it
+    for a Cga kernel; it reads the function, block, smem and cluster shape."""
+    from cuda.bindings import driver
+
+    from torch.cuda._utils import _check_cuda_bindings
+
+    if cta.cluster_x > 8:
+        attr = driver.CUfunction_attribute.CU_FUNC_ATTRIBUTE_NON_PORTABLE_CLUSTER_SIZE_ALLOWED
+        _check_cuda_bindings(driver.cuFuncSetAttribute(func, attr, 1))
+    config = driver.CUlaunchConfig()
+    config.gridDimX, config.gridDimY, config.gridDimZ = (int(_hint_of(v)) for v in (cta.x, cta.y, cta.z))
+    config.blockDimX, config.blockDimY, config.blockDimZ = m.threads, 1, 1
+    config.sharedMemBytes = m.smem
+    cluster = driver.CUlaunchAttribute()
+    cluster.id = driver.CUlaunchAttributeID.CU_LAUNCH_ATTRIBUTE_CLUSTER_DIMENSION
+    cluster.value.clusterDim.x, cluster.value.clusterDim.y, cluster.value.clusterDim.z = cta.cluster_x, 1, 1
+    policy = driver.CUlaunchAttribute()
+    policy.id = driver.CUlaunchAttributeID.CU_LAUNCH_ATTRIBUTE_CLUSTER_SCHEDULING_POLICY_PREFERENCE
+    policy.value.clusterSchedulingPolicyPreference = (
+        driver.CUclusterSchedulingPolicy.CU_CLUSTER_SCHEDULING_POLICY_SPREAD
+        if cta.cluster_x > 1
+        else driver.CUclusterSchedulingPolicy.CU_CLUSTER_SCHEDULING_POLICY_DEFAULT
+    )
+    config.attrs, config.numAttrs = [cluster, policy], 2
+    return _check_cuda_bindings(driver.cuOccupancyMaxActiveClusters(driver.CUfunction(func), config))
+
+
+# (function, cluster x): max_active_clusters, which plan_check found the same
+# at every grid; a trace reads it here, as it loads no module (a capture holds)
+_ACTIVE: dict[tuple[int, int], int] = {}
+
+
+def _hint_of(v: Any) -> int:
+    if isinstance(v, torch.SymInt):
+        from torch.cuda._host_trace_tape import _hint
+
+        return _hint(v)
+    return v
+
+
+def launch_plan(k: Kernels, device: int) -> tuple[Meta, Select, Cta, int]:
+    """run()'s kernel, its CTA config and function: plan(), then the Cga
+    fallback to Gmem where too few clusters fit at once."""
+    m, s, cta = plan(k)
+    func = function(m, device)
+    if s.multi == MCKV_CGA and k.force is None:
+        if (func, cta.cluster_x) not in _ACTIVE:
+            _ACTIVE[func, cta.cluster_x] = max_active_clusters(func, m, cta)
+        active = _ACTIVE[func, cta.cluster_x]
+        # the occupancy is the function's and the cluster shape's alone (checked
+        # against the grid at the hint); the CTA count is a guard
+        if active * cta.cluster_x < cta.x * cta.y * cta.z:
+            s.force_gmem, s.multi = True, MCKV_GMEM
+            k.select(s)
+            m = k.meta(s)
+            cta = k.cta(m, s)
+            if s.select_new:
+                raise RuntimeError("trtllm-gen: the Gmem fallback selected another kernel")
+            func = function(m, device)
+    return m, s, cta, func
+
+
+# a selected launch's candidates: Persistent, Gmem, then Cga at cluster 2 .. 16,
+# so the selector is the split where it picks Cga
+CANDIDATES = ((MCKV_DISABLED, 1), (MCKV_GMEM, 0), *((MCKV_CGA, c) for c in range(2, 17)))
+
+
+def _where(c: Any, a: Any, b: Any) -> Any:
+    from torch.cuda._host_trace import select
+
+    return select(c, a, b) if isinstance(c, torch.SymBool) else a if c else b
+
+
+def candidates(p: Runner, sm: int, max_smem: int, device: int) -> tuple[list[tuple[Meta, Select, Cta, int]], Any]:
+    """launch_plan as a selection: each region's (kernel, CTA config,
+    function), forced whatever the call's batch and max_kv, and the index of
+    the one launch_plan picks as an expression of them, which guards nothing.
+    For a generation call that may split the KV (SwapsMmaAb, Gmem reduction)."""
+    plans = []
+    for force in CANDIDATES:
+        plans.append(launch_plan(Kernels(p, sm, max_smem, force), device))
+    _, s, gmem, _ = plans[1]
+    if s.kernel_type != SWAPS_AB or s.multi != MCKV_GMEM or s.mask == SLIDING_OR_CHUNKED or p.hd_v >= 512:
+        raise NotFound("a selection outside generation with a Gmem reduction")
+    n = gmem.max_ctas_kv
+    split: Any = 1
+    for c in range(16, 1, -1):
+        m, _, cta, func = plans[c]
+        if (func, cta.cluster_x) not in _ACTIVE:
+            _ACTIVE[func, cta.cluster_x] = max_active_clusters(func, m, cta)
+        # launch_plan's fallback to Gmem where fewer clusters fit at once than the grid has
+        fallback = _ACTIVE[func, cta.cluster_x] * cta.cluster_x < cta.x * cta.y * cta.z
+        split = _where(n == c, _where(fallback, 1, c), split)
+    return plans, _where(n <= 1, 0, _where(n > 16, 1, split))
+
+
+# KernelParams (kernelParams.h, alignas 64): passed as 8 pieces, the TMA
+# descriptors whole (tmaQ_ .. tmaVSf_) and the fields after them
+PARAMS_SIZE = 1344
+PIECES = ((0, 128), (128, 128), (256, 128), (384, 128), (512, 128), (640, 128), (768, 128), (896, 448))
+TMA_Q, TMA_K, TMA_V, TMA_O = 0, 1, 3, 4
+FIELDS = 7
+_BASE = 896
+# pointer members, by name, at their byte offset in KernelParams
+_POINTER_AT = {
+    "o": 912, "sinks": 928, "cum_q": 936, "cum_kv": 944, "counter": 1000, "output_scale": 1008, "page_idx": 1016,
+    "partial_o": 1024, "partial_stats": 1032, "scale_log2": 1072, "seq_lens": 1096, "softmax_stats": 1112,
+}
+# int32 members
+_INT_AT = {
+    "window": 1128, "batch": 1132, "max_q": 1172, "max_kv": 1176, "ctas_q": 1180, "ctas_kv": 1184,
+    "pages_per_seq": 1188, "heads_kv": 1192, "heads_q": 1196, "heads_q_per_kv": 1200, "pool": 1232,
+    "tokens_per_cta_q": 1236, "page_log2": 1240, "reshape_kv": 1244, "sparse_top_k": 1268,
+    "sf_start": 1272, "sum_q": 1276,
+}
+_HIDDEN_O_AT = 1224  # int64
+_FLOAT_AT = {"output_scale": 1248, "scale_log2": 1252, "scale_sf_kv": 1256, "scale_sf_o": 1260, "skip_threshold": 1264}
+_FAST_MOD_DIV_AT = 1204
+_SHARED_PAGED_KV_IDX_AT = 1285
+
+
+def _f32_bits(x: float) -> int:
+    return struct.unpack("<i", struct.pack("<f", x))[0]
+
+
+def fast_mod_div(d: int) -> bytes:
+    """cuda::fast_mod_div<int32_t>(d): divisor, multiplier, add, shift."""
+    shift = (d - 1).bit_length() - 1
+    multiplier = -(-(1 << (32 + shift)) // d) & 0xFFFFFFFF
+    return struct.pack("<iIIi", d, multiplier, 0, shift)
+
+
+@dataclasses.dataclass
+class Tma:
+    """A buildNdTmaDescriptor call: the piece, the encode's dtype and swizzle,
+    the box, and the address, extents and byte strides as slot values."""
+
+    piece: int
+    dtype: int
+    swizzle: int
+    box: tuple[int, ...]
+    address: Any
+    shape: tuple[Any, ...]
+    strides: tuple[Any, ...]  # in bytes, of every dimension but the first
+
+
+def _tma(piece: int, dtype: int, shape: list, strides: list, box: list, address: Any, swizzled: bool = True) -> Tma:
+    from cuda.bindings import driver
+
+    T, S = driver.CUtensorMapDataType, driver.CUtensorMapSwizzle
+    if dtype in (E4M3, INT8):
+        fmt = T.CU_TENSOR_MAP_DATA_TYPE_UINT8
+    elif dtype == FP16:
+        fmt = T.CU_TENSOR_MAP_DATA_TYPE_FLOAT16
+    elif dtype == BF16:
+        fmt = T.CU_TENSOR_MAP_DATA_TYPE_BFLOAT16
+    else:
+        raise NotFound(f"a TMA descriptor of Data_type {dtype}")
+    lead = box[0] * _BITS[dtype] // 8
+    if not swizzled:
+        swizzle = S.CU_TENSOR_MAP_SWIZZLE_NONE
+    elif lead % 128 == 0:
+        swizzle = S.CU_TENSOR_MAP_SWIZZLE_128B
+    elif lead % 64 == 0:
+        swizzle = S.CU_TENSOR_MAP_SWIZZLE_64B
+    elif lead % 32 == 0:
+        swizzle = S.CU_TENSOR_MAP_SWIZZLE_32B
+    else:
+        raise RuntimeError(f"Unexpected numBytesInLeadingDim {lead}")
+    if strides[0] != 1:
+        raise RuntimeError("a TMA descriptor's first stride is not 1")
+    elt = max(_BITS[dtype], 8) // 8
+    return Tma(piece, int(fmt), int(swizzle), tuple(box), address, tuple(shape), tuple(s * elt for s in strides[1:]))
+
+
+@dataclasses.dataclass
+class Call:
+    """The launcher's arguments beyond Runner's: the addresses (traced
+    tensors' data_ptr(), 0 for nullptr) and the float scalars."""
+
+    o: Any
+    q: Any
+    k: Any
+    v: Any
+    page_idx: Any
+    seq_lens: Any
+    workspace: Any
+    workspace_size: Any
+    counter: Any = 0
+    cum_q: Any = 0
+    sinks: Any = 0
+    lse: Any = 0
+    scale_log2_ptr: Any = 0
+    output_scale_ptr: Any = 0
+    bmm1_scale: float = 1.0
+    bmm2_scale: float = 1.0
+    skip_threshold: float = 0.0
+    uses_shared_paged_kv_idx: bool = True
+    cum_kv: Any = 0
+    o_sf_scale: float = 1.0
+    o_sf_start_index: int = 0
+    sparse_top_k: int = 0
+
+
+_STATS_GUARD_BYTES = 1 << 20  # kTrtllmGenSoftmaxStatsGuardBytes
+M_LOG2E = 1.44269504088896340736
+
+
+def _round_up(x: Any, m: int) -> Any:
+    return (x + m - 1) // m * m
+
+
+def _given(address: Any) -> bool:
+    """Whether an address is passed: a traced tensor's (a SymInt) or a nonzero int."""
+    return isinstance(address, torch.SymInt) or address != 0
+
+
+def workspace(p: Runner, c: Call) -> tuple[Any, Any, Any]:
+    """The launcher's AlignedAllocator carve-out of the workspace: the softmax
+    stats (with lse) then the multi-CTA scratch (decode), 0 for none. The
+    workspace's address % 16 == 0 is a guard (std::align then moves nothing);
+    the bytes used, which must fit the workspace."""
+    stats = scratch = 0
+    used = 0
+    if _given(c.lse):
+        used = 8 * p.heads_q * p.batch * _round_up(p.max_q, 256) + _STATS_GUARD_BYTES
+        stats = c.workspace
+    if p.kernel_type != CONTEXT:
+        scratch = c.workspace + used
+    return stats, scratch, used
+
+
+def params(p: Runner, m: Meta, s: Select, cta: Cta, c: Call) -> tuple[bytearray, list[tuple[int, int, Any, bool]], list[Tma]]:
+    """setKernelParams (and run()'s sage members, all 0): the constant bytes,
+    each (offset, width, value, is_pointer) member that is a trace value, and
+    the four TMA descriptors."""
+    if m.dtype_kv == E2M1 or m.dtype_k != m.dtype_v:
+        raise NotFound("FP4 KV or K and V of different types")
+    image = bytearray(PARAMS_SIZE)
+    fields: list[tuple[int, int, Any, bool]] = []
+
+    def put(at: int, width: int, v: Any, pointer: bool = False) -> None:
+        if isinstance(v, torch.SymInt) or (pointer and v != 0):
+            fields.append((at, width, v, pointer))
+        else:
+            struct.pack_into({1: "<?", 4: "<i", 8: "<q"}[width], image, at, v)
+
+    hd_max = max(p.hd_qk, p.hd_v)
+    # Q (makeTmaShapeStrideQ)
+    clamp_q = min(1024 // _BITS[m.dtype_q], p.hd_qk)
+    grouped = min(m.tile_q, p.heads_q_per_kv) if m.groups_heads_q else 1
+    heads = p.heads_q // grouped
+    stride_tokens = p.q_stride_tokens if p.q_stride_tokens else p.heads_q * p.hd_qk
+    stride_grouped = p.q_stride_heads if p.q_stride_heads else p.hd_qk
+    stride_heads = stride_grouped * grouped if m.groups_heads_q else stride_grouped
+    box_q = [clamp_q, 1, 1, m.tile_q]
+    per_cta = m.step_q
+    if m.groups_heads_q:
+        if m.groups_tokens_heads_q:
+            box_q = [clamp_q, grouped, 1, m.tile_q // grouped]
+            per_cta = m.step_q // grouped
+        else:
+            box_q = [clamp_q, m.step_q, 1, 1]
+            per_cta = 1
+    tq = _tma(TMA_Q, m.dtype_q, [p.hd_qk, grouped, heads, p.sum_q], [1, stride_grouped, stride_heads, stride_tokens], box_q, c.q)
+    # K and V (makeTmaShapeStrideKv), paged
+    keys_per_tile = min(p.page, m.tile_kv)
+    clamp_kv = min(1024 // _BITS[m.dtype_k], hd_max, 128)
+    swizzle_kv = m.dtype_k == m.dtype_q
+    reshape = 1
+    if p.hd_qk == p.hd_v and not swizzle_kv and p.kv_stride_keys == p.hd_qk:
+        reshape = max(1, min(128 // hd_max, 128 // (hd_max * _BITS[m.dtype_k] // 8), keys_per_tile))
+    shape_kv = [hd_max * reshape, p.page // reshape, p.heads_kv, p.pool]
+    stride_kv = [1, p.kv_stride_keys * reshape, p.kv_stride_heads, p.kv_stride_batch]
+    box_kv = [clamp_kv * reshape, keys_per_tile // reshape, 1, 1]
+    tk = _tma(TMA_K, m.dtype_k, shape_kv, stride_kv, box_kv, c.k, swizzle_kv)
+    tv = _tma(TMA_V, m.dtype_v, shape_kv, stride_kv, box_kv, c.v, swizzle_kv)
+    # O (makeTmaShapeStrideO): Q's data type
+    shape_o = [p.hd_v, p.sum_q, p.heads_kv, p.heads_q_per_kv, 1]
+    stride_o = [1, p.heads_q * p.hd_v, p.hd_v, p.heads_kv * p.hd_v, 0]
+    to = _tma(TMA_O, m.dtype_q, shape_o, stride_o, [clamp_q, m.tile_q, 1, 1, 1], c.o)
+
+    stats, scratch, _ = workspace(p, c)
+    for name, v in (("o", c.o), ("sinks", c.sinks), ("cum_q", c.cum_q), ("cum_kv", c.cum_kv if p.kernel_type == CONTEXT else 0),
+                    ("counter", c.counter if p.kernel_type != CONTEXT else 0), ("output_scale", c.output_scale_ptr),
+                    ("page_idx", c.page_idx), ("partial_stats", scratch), ("scale_log2", c.scale_log2_ptr),
+                    ("seq_lens", c.seq_lens), ("softmax_stats", stats)):
+        put(_POINTER_AT[name], 8, v, True)
+    # ptrPartialStats + multiProcessorCount * stepQ float2s, a constant where
+    # there is no scratch (context: nullptr + offset)
+    put(_POINTER_AT["partial_o"], 8, scratch + p.sm_count * m.step_q * 8, _given(scratch))
+    ints = {
+        "window": p.window, "batch": p.batch, "max_q": p.max_q, "max_kv": p.max_kv, "ctas_q": cta.max_ctas_q,
+        "ctas_kv": cta.max_ctas_kv, "pages_per_seq": p.pages_per_seq, "heads_kv": p.heads_kv, "heads_q": p.heads_q,
+        "heads_q_per_kv": p.heads_q_per_kv, "pool": p.pool, "tokens_per_cta_q": per_cta,
+        "page_log2": p.page.bit_length() - 1, "reshape_kv": reshape, "sparse_top_k": c.sparse_top_k,
+        "sf_start": c.o_sf_start_index, "sum_q": p.sum_q,
+    }
+    for name, v in ints.items():
+        put(_INT_AT[name], 4, v)
+    put(_HIDDEN_O_AT, 8, p.heads_q * p.hd_qk)
+    floats = {
+        "output_scale": c.bmm2_scale, "scale_log2": c.bmm1_scale * M_LOG2E, "scale_sf_kv": 1.0,
+        "scale_sf_o": c.o_sf_scale, "skip_threshold": c.skip_threshold,
+    }
+    for name, x in floats.items():
+        struct.pack_into("<f", image, _FLOAT_AT[name], x)
+    image[_FAST_MOD_DIV_AT : _FAST_MOD_DIV_AT + 16] = fast_mod_div(p.heads_q_per_kv)
+    image[_SHARED_PAGED_KV_IDX_AT] = int(c.uses_shared_paged_kv_idx)
+    return image, fields, [tq, tk, tv, to]
+
+
+DECODE, PREFILL = "decode", "context"
+
+
+def _ptr(t: Any) -> Any:
+    return 0 if t is None else t.data_ptr()
+
+
+def _scale(x: Any) -> tuple[float, Any]:
+    """A Variant<double, Tensor> scale: (value, address); a tensor is 1.0 plus its address."""
+    return (1.0, x.data_ptr()) if hasattr(x, "data_ptr") else (float(x), 0)
+
+
+def from_binding(kind: str, args: tuple) -> tuple[Runner, Call, bool]:
+    """trtllm_paged_attention_{decode,context}'s argument handling: the binding's
+    positional args (tensors are anything with shape, stride(), dtype and
+    data_ptr()) as the launcher's RunnerParams, its Call and enable_pdl."""
+    out, out_sf, q, k, v, ws, counter, pages, seq_lens, max_q, max_kv, bmm1, bmm2, o_sf_scale, _, o_sf_start, batch, window_left = args[:18]
+    if kind == DECODE:
+        sparse_top_k, sm_count, pdl, ws_size, sinks, cum_q, k_sf, v_sf, skip, shared, lse = args[18:29]
+        block_sparse, top_k_lens, transform, fp16_softmax = args[31:35]
+        cum_kv, spcompress, causal = None, False, True
+        if block_sparse or top_k_lens is not None or sparse_top_k > 0:
+            raise NotFound("block-sparse or sparse MLA")
+    else:
+        cum_q, cum_kv, sm_count, pdl, ws_size, sinks, k_sf, v_sf, skip, shared, fp16_softmax, spcompress, causal, lse = args[18:32]
+        sparse_top_k, transform = 0, TRANSFORM_FULL
+    if out_sf is not None or k_sf is not None or v_sf is not None or q.dtype not in _DTYPES or k.dtype not in _DTYPES:
+        raise NotFound("block scales or an unsupported dtype")
+    if k.dtype == torch.uint8 or q.dtype == torch.uint8 or out.dtype == torch.uint8:
+        raise NotFound("FP4")
+    hd_qk, hd_v = q.shape[-1], out.shape[-1]
+    if (hd_qk, hd_v) in ((576, 512), (320, 256)):
+        raise NotFound("MLA")
+    bmm1_value, bmm1_ptr = _scale(bmm1)
+    bmm2_value, bmm2_ptr = _scale(bmm2)
+    skip = 0.0 if skip is None else float(skip)
+    decode = kind == DECODE
+    p = Runner(
+        dtype_q=_DTYPES[q.dtype], dtype_kv=_DTYPES[k.dtype], dtype_o=_DTYPES[out.dtype],
+        kernel_type=GENERATION if decode else CONTEXT, mask=CAUSAL if causal else DENSE,
+        scheduler=STATIC if decode else PERSISTENT, multi=decode, hd_qk=hd_qk, hd_v=hd_v,
+        heads_q=q.shape[1], heads_kv=k.shape[-3], page=k.shape[-2], max_q=max_q, max_kv=max_kv,
+        batch=batch, sum_q=q.shape[0], pages_per_seq=pages.shape[-1],
+        pool=k.shape[0] if k.data_ptr() == v.data_ptr() else 2 * k.shape[0],
+        window=INT_MAX if window_left == -1 else window_left + 1, sm_count=sm_count,
+        skips_softmax=skip != 0.0, fp16_softmax=bool(fp16_softmax), spcompress=bool(spcompress),
+        transform=transform, q_stride_tokens=q.stride()[0], q_stride_heads=q.stride()[1],
+        kv_stride_keys=k.stride()[-2], kv_stride_heads=k.stride()[-3], kv_stride_batch=k.stride()[0],
+    )
+    c = Call(
+        o=out.data_ptr(), q=q.data_ptr(), k=k.data_ptr(), v=v.data_ptr(), page_idx=pages.data_ptr(),
+        seq_lens=seq_lens.data_ptr(), workspace=ws.data_ptr(), workspace_size=ws_size,
+        counter=counter.data_ptr() if decode else 0, cum_q=_ptr(cum_q), sinks=_ptr(sinks), lse=_ptr(lse),
+        scale_log2_ptr=bmm1_ptr, output_scale_ptr=bmm2_ptr, bmm1_scale=bmm1_value, bmm2_scale=bmm2_value,
+        skip_threshold=skip, uses_shared_paged_kv_idx=True if shared is None else bool(shared),
+        cum_kv=_ptr(cum_kv), o_sf_scale=o_sf_scale, o_sf_start_index=o_sf_start, sparse_top_k=sparse_top_k,
+    )
+    return p, c, bool(pdl)
+
+
+# ---- part 4: the trace's launch records
+
+_LSE_LAYOUT = ((0, 8), (8, 8), (16, 4), (24, 8), (32, 8), (40, 4))  # md, lse, heads_q, two strides, n
+
+
+def _lse_strides(kind: str, args: tuple) -> tuple[Any, Any]:
+    return args[29:31] if kind == DECODE else args[32:34]
+
+
+def cluster_attributes(cluster_x: int) -> tuple[tuple[Any, Any], ...]:
+    """The launch attributes run() sets for a cluster width, as
+    explicit_attributes reads them off its node."""
+    from cuda.bindings import driver
+
+    from torch.cuda._host_trace_capture import plain_attributes
+
+    a, policy = driver.CUlaunchAttributeID, driver.CUclusterSchedulingPolicy
+    pairs = [(a.CU_LAUNCH_ATTRIBUTE_CLUSTER_DIMENSION, (cluster_x, 1, 1))]
+    if cluster_x > 1:
+        pairs.append((a.CU_LAUNCH_ATTRIBUTE_CLUSTER_SCHEDULING_POLICY_PREFERENCE, int(policy.CU_CLUSTER_SCHEDULING_POLICY_SPREAD)))
+    plain = plain_attributes(torch.cuda.current_device())
+    return tuple((k, v) for k, v in pairs if v != plain.get(k))
+
+
+@dataclasses.dataclass(frozen=True)
+class SelectedLaunch:
+    """A generation call's FMHA launch as candidates (CANDIDATES' order) and
+    the index of the one the launcher picks, an expression of the trace's
+    values; `guards` holds the ranges of the trace's guards candidates() and
+    building the candidates added."""
+
+    candidates: tuple[Any, ...]  # KernelLaunch
+    pointers: tuple[tuple[bool, ...], ...]  # per candidate, per slot
+    selector: Any
+    guards: tuple[int, int, int, int]
+
+
+# With SELECT, a generation call's trace records the candidate candidates()
+# picks at the trace's values, guarded for the graph by selector == its index,
+# instead of launch_plan's region guards: the variant replays any batch and
+# max_kv that pick the same candidate. A list SELECTED (armF/fork/select_driver.py)
+# also gets every candidate built, as a SelectedLaunch.
+SELECT = os.environ.get("FLASHINFER_HT_SELECT") == "1"
+SELECTED: list[SelectedLaunch] | None = None
+
+
+def record(kind: str, binding: Any, args: tuple) -> None:
+    """The binding's launches, on the current trace's traced tensors, as
+    KernelLaunches whose every field is an expression of the trace's values:
+    the port's kernel selection and setKernelParams under guards, checked
+    byte for byte against the binding's own launch on stand-ins at the hints.
+    A decline raises the trace's Declined, which leaves the call eager."""
+    from torch.cuda._host_trace_capture import capture_kernel_nodes, explicit_attributes, KernelNode, pack_params
+    from torch.cuda._host_trace_cute import _stand_in
+    from torch.cuda._host_trace_launch import _DSL_ENCODE_BIT, _GRID_LIMITS, KernelLaunch, TmaDescriptor
+    from torch.cuda._host_trace_tape import _hint, _PLACEHOLDER_LOW, _TracedTensor, current_trace
+    from torch.utils._python_dispatch import _disable_current_modes
+
+    tr = current_trace()
+
+    def require(cond: Any, what: str) -> None:
+        if not bool(cond):
+            raise tr.decline(f"trtllm-gen {kind}: {what} does not hold")
+
+    def pin(v: Any) -> int:
+        h = _hint(v)
+        require(v == h, f"{v} == {h}")
+        return int(h)
+
+    if torch.cuda.current_device() != tr.device.index or torch.cuda.current_stream() != tr.stream:
+        raise tr.decline(f"trtllm-gen {kind}: called off the trace's device or stream")
+    if any(isinstance(a, torch.Tensor) and not isinstance(a, _TracedTensor) for a in args):
+        raise tr.decline(f"trtllm-gen {kind}: a tensor the trace does not track")
+    try:
+        p, c, pdl = from_binding(kind, args)
+        # max_kv enters a context call's params only (selectKernel's tile
+        # choice is generation's), a generation call's split count, params
+        # and, at max_q > 1, its tile choice (Kernels._select_tile_q's guard)
+        p = dataclasses.replace(p, hd_qk=pin(p.hd_qk), hd_v=pin(p.hd_v), heads_q=pin(p.heads_q), heads_kv=pin(p.heads_kv),
+                                page=pin(p.page), window=pin(p.window), sm_count=pin(p.sm_count))
+        require(p.heads_q % p.heads_kv == 0, "heads_q % heads_kv == 0")
+        # only what armF/fork/xcheck_params.py checked byte for byte against the C++ launcher
+        require((p.dtype_q, p.dtype_kv, p.dtype_o) == (BF16, BF16, BF16), "bf16 q, KV and out (cross-checked)")
+        require((p.mask, p.window, p.transform) == (CAUSAL, INT_MAX, TRANSFORM_FULL), "causal, no sliding window (cross-checked)")
+        require(not (p.skips_softmax or p.fp16_softmax or p.spcompress), "no skip-softmax, fp16 softmax or sparse compression (cross-checked)")
+        require(p.hd_qk == p.hd_v in (64, 128) and p.page in (16, 64), "head dim 64 or 128, page 16 or 64 (cross-checked)")
+        props = torch.cuda.get_device_properties(tr.device)
+        sm, max_smem = props.major * 10 + props.minor, props.shared_memory_per_block_optin
+        plans = None
+        if SELECT and kind == DECODE and p.max_q == 1:
+            env = tr.shape_env
+            first = len(env.records if hasattr(env, "records") else env.guards)
+            try:
+                plans, selector = candidates(p, sm, max_smem, tr.device.index)
+                guards = (first, len(env.records if hasattr(env, "records") else env.guards))
+            except NotFound:
+                pass
+        if plans is None:
+            m, s, cta, func = launch_plan(Kernels(p, sm, max_smem), tr.device.index)
+        else:
+            at = _hint_of(selector)
+            m, s, cta, func = plans[at]
+            # the native replay switches no node between two kernels with TMA
+            # descriptors (add_entry): a variant per candidate
+            op, env.op = env.op, None
+            try:
+                require(selector == at, f"the selection of candidate {at}")
+            finally:
+                env.op = op
+        if s.multi == MCKV_GMEM_SEPARATE:
+            raise NotFound("a separate reduction kernel (GmemReductionWithSeparateKernel)")
+    except NotFound as e:
+        raise tr.decline(f"trtllm-gen {kind}: {e}") from None
+    _, _, used = workspace(p, c)
+    require(used <= c.workspace_size, "the softmax stats fit the workspace")
+    for a in (c.o, c.q, c.k, c.v, c.workspace):
+        require(a % 16 == 0, "a TMA or workspace address % 16 == 0")
+
+    def fmha_launch(m: Meta, s: Select, cta: Cta, func: int, attributes: tuple) -> tuple[KernelLaunch, list[bool]]:
+        image, members, tmas = params(p, m, s, cta, c)
+        grid = (cta.x, cta.y, cta.z)
+        for axis, (extent, limit) in enumerate(zip(grid, _GRID_LIMITS)):
+            require(extent >= 1, f"grid axis {axis} >= 1")
+            require(extent <= limit, f"grid axis {axis} <= {limit}")
+        require(cta.x % cta.cluster_x == 0, f"grid x % {cta.cluster_x} == 0")
+        slots: list[Any] = []
+        fields: list[tuple[int, int, int]] = []
+        pointers: list[bool] = []
+        for at, width, v, pointer in members:
+            if not pointer:
+                require(v >= -(2 ** (8 * width - 1)), f"a {8 * width}-bit member >= its min")
+                require(v <= 2 ** (8 * width - 1) - 1, f"a {8 * width}-bit member <= its max")
+            fields.append((FIELDS, at - _BASE, width))
+            slots.append(v)
+            pointers.append(pointer)
+        descriptors = []
+        for x in tmas:
+            for n in x.shape:
+                require(n >= 1, "a TMA extent >= 1")
+                require(n <= 2**32, "a TMA extent <= 2**32")
+            for b in x.strides:
+                require(b % 16 == 0, "a TMA byte stride % 16 == 0")
+                require(b < 2**40, "a TMA byte stride < 2**40")
+            descriptors.append(TmaDescriptor(x.piece, len(slots), x.dtype, x.box, x.swizzle))
+            slots += [x.address, *x.shape, *x.strides]
+            pointers += [True] + [False] * (2 * len(x.box) - 1)
+        if not all(isinstance(v, torch.SymInt) for v, q in zip(slots, pointers) if q):
+            raise tr.decline(f"trtllm-gen {kind}: a pointer that is not a traced tensor's")
+        images = tuple(bytes(image[lo : lo + n]) for lo, n in PIECES)
+        launch = KernelLaunch(m.name, func, None, PIECES, grid, (m.threads, 1, 1), m.smem, tuple(slots), tuple(roots), None,
+                              tuple(fields), tuple(descriptors), attributes, frozenset(i for i, q in enumerate(pointers) if q),
+                              images, programmatic=pdl, packed=True)
+        return launch, pointers
+
+    roots: list[Any] = []
+    for a in args:
+        if isinstance(a, _TracedTensor) and not any(r is a._root for r in roots):
+            roots.append(a._root)
+    stand_ins = [_stand_in(a) if isinstance(a, _TracedTensor) else _hint(a) for a in args]
+    with _disable_current_modes():
+        anchor = torch.empty(1, device=tr.device)
+
+    def run(_: torch.cuda.Stream) -> None:
+        with _disable_current_modes():
+            anchor.fill_(0)
+            binding(*stand_ins)
+
+    _, *nodes = capture_kernel_nodes(run)
+    if not nodes or any(not isinstance(n, KernelNode) for n in nodes):
+        raise tr.decline(f"trtllm-gen {kind}: the binding launched {nodes}")
+    node, *rest = nodes
+    attributes = explicit_attributes(node)
+    keys = {getattr(k, "name", str(k)) for k, _ in attributes}
+    if not keys <= {"CU_LAUNCH_ATTRIBUTE_CLUSTER_DIMENSION", "CU_LAUNCH_ATTRIBUTE_CLUSTER_SCHEDULING_POLICY_PREFERENCE"}:
+        raise tr.decline(f"trtllm-gen {kind}: launch attributes {keys}")
+
+    def matches(fmha: KernelLaunch, pointers: list[bool], cluster_x: int) -> bool:
+        hints = [_hint(v) & _PLACEHOLDER_LOW if q else _hint(v) for v, q in zip(fmha.slots, pointers)]
+        mine = bytearray(b"".join(pack_params(fmha, hints, pointers)))
+        real = bytearray(b"".join(node.images))
+        for d in fmha.descriptors:
+            real[PIECES[d.param][0] + 8] |= _DSL_ENCODE_BIT
+        evaluated = (fmha.name, tuple(map(_hint, fmha.grid)), fmha.block, fmha.smem, (cluster_x, 1, 1), fmha.attributes,
+                     node.layout == ((0, PARAMS_SIZE),))
+        launched = (node.name, node.grid, node.block, node.smem, records[0].cluster, attributes, True)
+        if evaluated != launched or mine != real:
+            bad = [i for i in range(len(real)) if i >= len(mine) or mine[i] != real[i]]
+            raise tr.decline(f"trtllm-gen {kind}: the binding launched {launched}, the port {evaluated}; {len(bad)} param bytes differ from {bad[:1]}")
+        return True
+
+    fmha, pointers = fmha_launch(m, s, cta, func, attributes)
+    records = [fmha]
+    matches(fmha, pointers, cta.cluster_x)
+    if plans is not None and SELECTED is not None:
+        start = len(env.records if hasattr(env, "records") else env.guards)
+        built = [fmha_launch(*plan, cluster_attributes(plan[2].cluster_x)) for plan in plans]
+        guards += (start, len(env.records if hasattr(env, "records") else env.guards))
+        at = _hint_of(selector)
+        # the candidate at the trace's values is the launch, byte for byte
+        if built[at][0].function != fmha.function or not matches(*built[at], plans[at][2].cluster_x):
+            raise tr.decline(f"trtllm-gen {kind}: the selection picks {built[at][0].name}, the launcher {fmha.name}")
+        SELECTED.append(SelectedLaunch(tuple(b[0] for b in built), tuple(tuple(b[1]) for b in built), selector, guards))
+
+    if _given(c.lse):
+        n = p.sum_q * p.heads_q
+        if bool(n > 512):
+            threads = 1024
+        else:
+            n = pin(n)
+            threads = 1 << max(n - 1, 0).bit_length()
+        stats, _, _ = workspace(p, c)
+        stride_tokens, stride_heads = _lse_strides(kind, args)
+        values = (stats, c.lse, p.heads_q, stride_tokens, stride_heads, n)
+        for v, bits in ((p.heads_q, 32), (n, 32), (stride_tokens, 64), (stride_heads, 64)):
+            require(v <= 2 ** (bits - 1) - 1, f"an LSE {bits}-bit argument fits")
+        if len(rest) != 1 or rest[0].layout != _LSE_LAYOUT:
+            raise tr.decline(f"trtllm-gen {kind}: the binding launched {[r.name for r in rest]} after the FMHA kernel")
+        lse = rest[0]
+        record_lse = KernelLaunch(lse.name, lse.function, None, _LSE_LAYOUT, (_ceil_div(n, threads), 1, 1), (threads, 1, 1), 0,
+                                  values, tuple(roots), None, tuple((i, 0, w) for i, (_, w) in enumerate(_LSE_LAYOUT)), (),
+                                  explicit_attributes(lse), frozenset((0, 1)), programmatic=pdl)
+        lse_hints = [_hint(v) & _PLACEHOLDER_LOW if i < 2 else _hint(v) for i, v in enumerate(values)]
+        got = (b"".join(pack_params(record_lse, lse_hints, [True, True, False, False, False, False])), tuple(map(_hint, record_lse.grid)), threads)
+        if got != (b"".join(lse.images), lse.grid, lse.block[0]) or record_lse.attributes:
+            raise tr.decline(f"trtllm-gen {kind}: the LSE kernel's launch is not the port's")
+        records.append(record_lse)
+    elif rest:
+        raise tr.decline(f"trtllm-gen {kind}: the binding launched {[r.name for r in rest]} after the FMHA kernel")
+    for r in records:
+        tr.record_launch(r)
+
+
+# ---- part 5: the custom ops a trace sees in place of the bindings
+
+# each binding argument as name:kind; T tensor (! written, ? optional),
+# S SymInt, i int, f float, b bool, V Variant<double, Tensor> (two op arguments)
+_SPECS = {
+    DECODE: "out:T!,out_sf:T!?,q:T,k:T,v:T,ws:T!,counter:T!,pages:T,seq_lens:T,max_q:S,max_kv:S,bmm1:V,bmm2:V,o_sf_scale:f,"
+    "o_sf_vec:i,o_sf_start:i,batch:S,window_left:i,sparse_top_k:i,sm_count:i,pdl:b,ws_size:S,sinks:T?,cum_q:T?,k_sf:T?,"
+    "v_sf:T?,skip:f?,shared:b?,lse:T!?,lse_st_tok:S,lse_st_heads:S,block_sparse:b,top_k_lens:T?,transform:i,fp16:b?",
+    PREFILL: "out:T!,out_sf:T!?,q:T,k:T,v:T,ws:T!,counter:T,pages:T,seq_lens:T,max_q:S,max_kv:S,bmm1:V,bmm2:V,o_sf_scale:f,"
+    "o_sf_vec:i,o_sf_start:i,batch:S,window_left:i,cum_q:T,cum_kv:T,sm_count:i,pdl:b,ws_size:S,sinks:T?,k_sf:T?,v_sf:T?,"
+    "skip:f?,shared:b?,fp16:b?,spcompress:b?,causal:b,lse:T!?,lse_st_tok:S,lse_st_heads:S",
+}
+_TYPES = {"T": "Tensor", "T?": "Tensor?", "S": "SymInt", "i": "SymInt", "f": "float", "f?": "float?", "b": "bool", "b?": "bool?"}
+_BINDINGS: dict[str, Any] = {}
+_OPS: dict[str, Any] = {}
+
+
+def _spec(kind: str) -> list[tuple[str, str]]:
+    return [tuple(a.split(":")) for a in _SPECS[kind].split(",")]  # type: ignore[misc]
+
+
+def _to_binding(kind: str, flat: tuple) -> tuple:
+    out, it = [], iter(flat)
+    for _, ty in _spec(kind):
+        if ty == "V":
+            value, tensor = next(it), next(it)
+            out.append(value if tensor is None else tensor)
+        else:
+            out.append(next(it))
+    return tuple(out)
+
+
+def _to_op(kind: str, args: tuple) -> tuple:
+    flat: list[Any] = []
+    for (_, ty), a in zip(_spec(kind), args, strict=True):
+        if ty == "V":
+            flat += [1.0, a] if isinstance(a, torch.Tensor) else [float(a), None]
+        else:
+            flat.append(a)
+    return tuple(flat)
+
+
+def preload(kind: str, args: Any) -> None:
+    """At a host trace's warm-up: load every kernel a trace or a redispatch
+    of the call's class can select (a generation call's at each split and,
+    at max_q > 1, each tile size), which they cannot under their captures."""
+    try:
+        p, _, _ = from_binding(kind, args)
+        props = torch.cuda.get_device_properties(args[0].device)
+        sm, max_smem, device = props.major * 10 + props.minor, props.shared_memory_per_block_optin, args[0].device.index
+        launch_plan(Kernels(p, sm, max_smem), device)
+        if kind == DECODE:
+            for force in CANDIDATES:
+                for tile in (128, 64, 32, 16, 8) if p.max_q > 1 else (None,):
+                    with contextlib.suppress(RuntimeError):
+                        m, s, cta, func = launch_plan(Kernels(p, sm, max_smem, force, tile=tile), device)
+                        # and the occupancy its Cga fallback reads
+                        if s.multi == MCKV_CGA and (func, cta.cluster_x) not in _ACTIVE:
+                            _ACTIVE[func, cta.cluster_x] = max_active_clusters(func, m, cta)
+            if SELECT and p.max_q == 1:
+                candidates(p, sm, max_smem, device)
+    except NotFound:
+        pass
+
+
+def _op(kind: str) -> Any:
+    if kind in _OPS:
+        return _OPS[kind]
+    params, written = [], []
+    for name, ty in _spec(kind):
+        if ty == "V":
+            params += [f"float {name}", f"Tensor? {name}_t"]
+        elif ty.startswith("T!"):
+            params.append(f"Tensor({chr(ord('a') + len(written))}!){ty[2:]} {name}")
+            written.append(name)
+        else:
+            params.append(f"{_TYPES[ty]} {name}")
+
+    def kernel(*flat: Any) -> None:
+        from torch.cuda._host_trace_tape import _TracedTensor, current_trace
+
+        args = _to_binding(kind, flat)
+        if current_trace() is not None and any(isinstance(a, _TracedTensor) for a in args):
+            record(kind, _BINDINGS[kind], args)
+            return
+        _BINDINGS[kind](*args)
+
+    op = torch.library.custom_op(f"flashinfer_ht::trtllm_paged_attention_{kind}", kernel, mutates_args=written,
+                                 device_types="cuda", schema=f"({', '.join(params)}) -> ()")
+    op.register_fake(lambda *flat: None)
+    _OPS[kind] = op
+    return op
+
+
+def traced(binding: Any, kind: str) -> Any:
+    """binding, run through the custom op under a dispatch mode (a host
+    trace's, and its warm-up's witness), so the trace records the port's
+    launches; else the binding itself."""
+    _BINDINGS[kind] = binding
+    op = _op(kind)
+
+    def call(*args: Any) -> Any:
+        if torch._C._len_torch_dispatch_stack():
+            from torch.cuda._host_trace_tape import _TracedTensor
+
+            if not any(isinstance(a, _TracedTensor) for a in args):
+                preload(kind, args)
+            return op(*_to_op(kind, args))
+        return binding(*args)
+
+    return call
